{
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "tkw hook post-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tkw hook stop",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["../temporal"],
    "allow": [
      "Read(./**)",
      "Read(../temporal/**)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo lint:*)",
      "Bash(cargo test-lint:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo +nightly fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo expand:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -C ../temporal show:*)",
      "Bash(git -C ../temporal grep:*)",
      "Bash(git -C ../temporal log:*)",
      "Bash(git -C ../temporal cat-file:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git cherry-pick:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cargo install:*)",
      "Bash(cargo sweep:*)",
      "Bash(cargo clean:*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/credentials)",
      "Read(//**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(./target/**)",
      "Read(./**/target/**)",
      "Edit(../temporal/**)",
      "Write(../temporal/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(cargo publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  }
}
