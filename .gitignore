# Rust build artifacts
/target/
**/target/

# Cargo lock for libraries (keep for binaries/workspace)
# Cargo.lock is committed for this workspace since it contains binaries

# IDE / editor
/.idea/
/.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment and secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.secret

# Debug
*.dSYM/
*.su
*.iml

# Coverage
*.profraw
*.profdata
lcov.info
tarpaulin-report.html

# Protobuf generated output (regenerated by build.rs)
# Keep proto source files, ignore generated artifacts outside OUT_DIR

# Benchmarks output
criterion/

# Runtime logs
tokeirad.log

# Archives
*.zip

# Proptest regressions (generated, not committed)
**/proptest-regressions/

# Scratch directory for commit messages, patch snapshots, and similar
# transient files. Nothing in this directory is ever committed.
/artifacts/

# Disposable catalog-selected provisioner composition roots.
/.tokeira-build/

# VS Code multi-root workspace file. Pre-existing commits contain this file;
# `git rm --cached tokeira.code-workspace` stopped tracking it at commit
# <SHA after next commit>.
/tokeira.code-workspace

# Codex silently prefers this file over AGENTS.md — never commit one
AGENTS.override.md

# Claude Code session-local state
.claude/settings.local.json
.claude/worktrees/
.claude/launch.json
.claude/wf-*.js
