  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "tags": [
    "tokeira",
    "storage",
    "projection",
    "dsql"
  ],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
