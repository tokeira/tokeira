// Canonical compose platform definition — root file (task 7.3).
//
// This is the platform author's structural artifact (Req 16): the DSL analog of
// the compiled compose platform (`platforms/compose/src/{config,compose,modules,
// services,images,observability_config}.rs`). It is shipped in this crate and,
// at `tkr deployment create`, persisted into the deployment; every apply then
// compiles the persisted copy, not this file (Req 16.3 / Property 23). Operators
// select the platform and supply the inputs below — they do not edit this file.
//
// The (language, kind-library) version is derived by the compiling `tkp` and
// recorded by the provisioner; it is never declared here (Req 9 / Property 12).
platform compose {
  use "images.platform"
  use "infra.platform"
  use "observability.platform"
  use "runtime.platform"

  // Operator-tunable values (Req 8). InMemory is the default storage; selecting
  // Dsql carries the cluster identity/region in the variant payload (see the
  // `match storage` arms in infra/runtime). Image refs mirror the pinned
  // observability versions in `ObservabilityConfig::default` / AGENTS.
  input project_name:      String  = "tokeira"
  input storage:           Storage = InMemory
  input tokeirad_image:    String  = "tokeirad:latest"
  input tokeirad_replicas: Int     = 1
  input grpc_port:         Port    = 7233
  input metrics_port:      Port    = 9090
  input grafana_port:      Port    = 3000
  input mimir_image:       String  = "grafana/mimir:3.0.6"
  input loki_image:        String  = "grafana/loki:3.7.1"
  input grafana_image:     String  = "grafana/grafana-oss:12.4.3"
  input alloy_image:       String  = "grafana/alloy:v1.16.0"
  input aws_cli_image:     String  = "public.ecr.aws/aws-cli/aws-cli:latest"
  input busybox_image:     String  = "public.ecr.aws/docker/library/busybox:latest"

  // Shared path building over the closed RuntimeContext — no OS access (Req 12.1).
  // These bind program-wide; the observability module reads them for its volumes.
  let state_dir  = ctx.deployment_dir / ".tokeira-state"
  let config_dir = ctx.deployment_dir / "config"

  namespaces [ "default" ]

  // Post-apply writeback into tokeirad.toml (parity with `collect_writeback`).
  // Only *output-derived* values appear here: the DSQL endpoint and the two
  // coordination-table names are unknown until the infra is provisioned, so they
  // lower to deferred output references the engine resolves at apply (Req 15).
  // The static `infrastructure.storage = "dsql"` and `infrastructure.dsql.region`
  // keys are known at create time and written with the server config rather than
  // via writeback — the writeback source grammar is output-references only.
  // Writeback realization (the actual tokeirad.toml write) is task 9.4.
  writeback when storage is Dsql {
    "infrastructure.dsql.endpoint"           : dsql.cluster.cluster_endpoint,
    "infrastructure.dsql.rate_limiter_table" : dsql.rate_limiter.table_name,
    "infrastructure.dsql.conn_lease_table"   : dsql.conn_lease.table_name,
  }
}
