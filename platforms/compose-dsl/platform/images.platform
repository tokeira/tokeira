// Image registry (parity with `images::tokeirad` + `images::observability`).
platform compose {
  // tokeirad is built locally; the six observability images are mirrored from
  // upstream into the deployment's registry. The `upstream` refs reuse the same
  // inputs the services consume, so a version bump is one edit. `desired_ref` and
  // `writeback_targets` belong to the kinds; realization into deploy-engine
  // images is task 9.3.
  image tokeirad = Build  { repository: "tokeira/tokeirad" }
  image mimir    = Mirror { repository: "tokeira/grafana-mimir", upstream: mimir_image }
  image loki     = Mirror { repository: "tokeira/grafana-loki",  upstream: loki_image }
  image grafana  = Mirror { repository: "tokeira/grafana",       upstream: grafana_image }
  image alloy    = Mirror { repository: "tokeira/grafana-alloy", upstream: alloy_image }
  image aws_cli  = Mirror { repository: "tokeira/aws-cli",       upstream: aws_cli_image }
  image busybox  = Mirror { repository: "tokeira/busybox",       upstream: busybox_image }
}
