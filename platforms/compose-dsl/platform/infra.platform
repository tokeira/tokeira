// Infrastructure modules: local state (always) and DSQL (only under Dsql storage).
platform compose {
  // remote-state analog — the deployment's local state directory (parity with
  // `LocalStateModule`/`LocalStateResource`). The compose-dsl engine bootstraps
  // its own `local_state` module and skips this same-named declaration; it is
  // declared here so the other modules' `depends_on [ local_state ]` edges
  // resolve against a known name (whole-program resolution, Req 13.5).
  module local_state {
    resource state = LocalStateDir { }
  }

  // DSQL persistence — present only under Dsql storage (parity with `DsqlModule`,
  // which the compose platform adds only when storage == Dsql). The payload-
  // bearing fields (mode/region/endpoint/arn) require a `match` to bind the
  // variant payload `d`; a `when` guard alone is a boolean and binds nothing, so
  // the resources live inside a `match storage` arm. Under the default InMemory
  // storage this module is absent and the arm is never evaluated. Realization of
  // these AWS resources (DsqlCluster + two coordination tables) is task 9.2.
  module dsql when storage is Dsql {
    depends_on [ local_state ]
    match storage {
      Dsql(d) => {
        resource cluster = DsqlCluster {
          mode:     d.mode,
          region:   d.region,
          endpoint: d.endpoint,
          arn:      d.arn,
        }
        resource rate_limiter = DynamoDbTable { hash_key: "pk", ttl: "ttl_epoch" }
        resource conn_lease   = DynamoDbTable { hash_key: "pk", ttl: "ttl_epoch" }
      }
      _ => { }
    }
  }
}
