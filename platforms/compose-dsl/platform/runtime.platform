// Runtime module: the tokeirad server (parity with `ComposeModule::runtime`).
platform compose {
  module runtime {
    // Storage-conditional wiring, mirroring `ComposeModule::dependencies`: under
    // Dsql, runtime waits on observability (which itself waits on the dsql infra);
    // under InMemory it waits only on local_state.
    depends_on match storage {
      Dsql(_) => [ observability ],
      _       => [ local_state ],
    }

    service tokeirad = ComposeService {
      image:    tokeirad_image,
      replicas: tokeirad_replicas,
      ports:    [ port(grpc_port), port(metrics_port) ],
      // tokeirad.toml is always mounted read-only so the server reads the
      // operator config (storage kind + DSQL endpoint after writeback).
      volumes:  [ bind(ctx.deployment_dir / "tokeirad.toml", "/etc/tokeira/tokeirad.toml", ro) ],
      // Declares the credential *need* under Dsql (Req 14.5): `tkp` injects the
      // ~/.aws mount + AWS_* at materialization — the DSL never reads a secret.
      // This replaces the compiled platform's manual `std::env` AWS passthrough.
      // (`is` is a condition-only operator, so the boolean is a value-`match`.)
      aws_auth: match storage { Dsql(_) => true, _ => false },
      env: match storage {
        Dsql(d) => { "TOKEIRA_CONFIG": "/etc/tokeira/tokeirad.toml", "AWS_REGION": d.region },
        _       => { "TOKEIRA_CONFIG": "/etc/tokeira/tokeirad.toml" },
      },
    }
  }
}
