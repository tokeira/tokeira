{
  "uid": "tokeira-storage-projection-health",
  "title": "Tokeira Storage / Projection Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["tokeira", "storage", "projection"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Build Info",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "tokeira_build_info", "legendFormat": "{{version}} {{commit}}" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Storage Latency",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tokeira_storage_commit_transition_duration_seconds_bucket[5m])))", "legendFormat": "commit p95" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tokeira_storage_load_run_duration_seconds_bucket[5m])))", "legendFormat": "load run p95" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tokeira_storage_read_history_duration_seconds_bucket[5m])))", "legendFormat": "read history p95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(tokeira_storage_commit_transition_duration_seconds_bucket[5m])))", "legendFormat": "commit p50" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(tokeira_storage_commit_transition_duration_seconds_bucket[5m])))", "legendFormat": "commit p99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Storage Operations",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum by (operation, result) (rate(tokeira_storage_repository_operation_total[5m]))", "legendFormat": "{{operation}} {{result}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Projection Throughput",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum by (partition) (rate(tokeira_projection_records_processed_total[5m]))", "legendFormat": "partition {{partition}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Projection Lag",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum by (partition) (tokeira_projection_worker_lag_records)", "legendFormat": "partition {{partition}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sink Health",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tokeira_projection_sink_write_duration_seconds_bucket[5m])))", "legendFormat": "write p95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(tokeira_projection_sink_write_duration_seconds_bucket[5m])))", "legendFormat": "write p50" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(tokeira_projection_sink_write_duration_seconds_bucket[5m])))", "legendFormat": "write p99" },
        { "expr": "sum(rate(tokeira_projection_sink_error_total[5m]))", "legendFormat": "errors" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 }
    }
  ]
}
