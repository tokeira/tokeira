// The Compose deployment definition: the single authored description of what a
// Compose deployment is. The frontend evaluates this source into one typed
// configuration (the `Compose` value returned by `config()`) and one structural
// graph (the modules, resources, and writeback declared by `deployment()`).
// Everything the deployment consists of is stated here, once — the platform
// crate defines no mirror of these types, and no other document describes the
// deployment.
//
// Operators change a deployment by editing this file (and its companions) and
// applying; each accepted edit is a configuration revision. Fields marked
// `#[create]` are fixed at deployment creation — an edit that changes one is
// refused at retarget check, because it names a different deployment rather
// than a change to this one.

// How the deployment stores workflow state. `Managed` creates and owns an
// Aurora DSQL cluster; `Preexisting` adopts one the operator already runs.
enum DsqlMode {
    Managed,
    Preexisting,
}

// DSQL storage settings. `endpoint` and `arn` identify an adopted cluster and
// accompany `Preexisting` only; a managed cluster derives its identity at
// creation. The `DsqlCluster` kind refuses inconsistent combinations at the
// authoring site.
struct DsqlStorage {
    region: String,
    mode: DsqlMode,
    endpoint: Option<String>,
    arn: Option<String>,
}

// The storage choice: keep workflow state in memory (development), or on
// Aurora DSQL plus its coordination tables (durable).
enum Storage {
    InMemory,
    Dsql(DsqlStorage),
}

// The tokeirad server container: image, capacity, and the two published ports
// (Temporal-compatible gRPC, Prometheus metrics).
struct Tokeirad {
    image: String,
    replicas: u32,
    grpc_port: u16,
    metrics_port: u16,
}

// One observability backend container: image and capacity.
struct Backend {
    image: String,
    replicas: u32,
}

// Grafana: image, capacity, published HTTP port, and the initial administrator
// password seeded at first start.
struct Grafana {
    image: String,
    replicas: u32,
    port: u16,
    admin_password: String,
}

// The observability stack: Mimir (metrics), Loki (logs), Grafana (dashboards),
// Alloy (collection).
struct Observability {
    mimir: Backend,
    loki: Backend,
    grafana: Grafana,
    alloy: Backend,
}

// The aws provider's deployment-level attributes: the deployed context,
// materialized under the provider's namespace. Resource-attached attributes
// take precedence by the provider's own rule.
struct Aws {
    region: String,
}

// The complete Compose configuration — the shape `config()` returns and the
// value every later revision edits. `storage` and `aws` are create-time:
// switching a deployment's storage or relocating its region is a different
// deployment.
struct Compose {
    #[create]
    storage: Storage,
    #[create]
    aws: Aws,
    tokeirad: Tokeirad,
    observability: Observability,
}

// One container environment variable.
struct Environment {
    name: String,
    value: String,
}

// A durable-data mount: `sub` names a subdirectory of the deployment's state
// root, mounted into the container at `at`. State volumes survive container
// replacement.
struct StateVolume {
    sub: String,
    at: String,
}

// A rendered-configuration mount: `sub` names a file or directory under the
// deployment's rendered-config root, mounted at `at`. The content is produced
// by the configuration resources below; its digest fences every consumer, so
// a content change is a visible container change.
struct ConfigVolume {
    sub: String,
    at: String,
}

// The mount families a service may declare. `DockerSocket` grants the
// container the host's Docker socket — used only by the collector, which
// discovers the other containers through it.
enum Volume {
    State(StateVolume),
    Config(ConfigVolume),
    DockerSocket,
}

// The deployment's configuration values. This function is the operator
// surface: its literals are the defaults a new deployment starts from, and
// revisions edit them in place. The observability images are pinned upstream
// references; Docker pulls them directly.
fn config() -> Compose {
    Compose {
        storage: Storage::InMemory,
        aws: Aws { region: "eu-west-2".into() },
        tokeirad: Tokeirad {
            image: "tokeirad:latest".into(),
            replicas: 1,
            grpc_port: 7233,
            metrics_port: 9090,
        },
        observability: Observability {
            mimir: Backend { image: "grafana/mimir:3.0.6".into(), replicas: 1 },
            loki: Backend { image: "grafana/loki:3.7.1".into(), replicas: 1 },
            grafana: Grafana {
                image: "grafana/grafana-oss:12.4.3".into(),
                replicas: 1,
                port: 3000,
                admin_password: "admin".into(),
            },
            alloy: Backend { image: "grafana/alloy:v1.16.0".into(), replicas: 1 },
        },
    }
}

// The deployment graph. Modules group resources and order coarsely: a module's
// dependency list names the modules applied before it, and destroy reverses
// the order. Within a module, a resource's trailing dependency list orders
// creation exactly — a service is never created before the configuration
// content it mounts exists, because a missing bind source would poison the
// mount.
//
// `cx.project_name` is the deployment's name, supplied by the framework; it
// scopes container names and provider resource identities.
fn deployment(cfg: Compose, cx: Context) -> Deployment {
    let d = Deployment::new(&["default"]);

    // Bootstrap: the deployment's local state root. Everything else stands on
    // it, so every other module depends on this one.
    let local_state = d.module("local_state", vec![]);
    local_state.resource("dir", LocalStateDir {});

    // Durable storage, present only when the configuration selects DSQL: the
    // cluster plus the two DynamoDB coordination tables. The writeback
    // entries feed the applied infrastructure's identities into the server
    // configuration document under `infrastructure.*` — literals pass through
    // as written; `output(...)` references resolve from the applied
    // resources' recorded outputs.
    if let Storage::Dsql(storage) = &cfg.storage {
        let dsql = d.module("dsql", vec![local_state]);
        let cluster = dsql.resource(
            "cluster",
            DsqlCluster {
                identity: format!("{}-compose", cx.project_name),
                region: storage.region.clone(),
                mode: storage.mode.clone(),
                endpoint: storage.endpoint.clone(),
                arn: storage.arn.clone(),
            },
        );
        let rate_limiter = dsql.resource(
            "rate_limiter",
            DynamoDbTable {
                table: format!("{}-dsql-rate-limiter", cx.project_name),
                region: storage.region.clone(),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );
        let conn_lease = dsql.resource(
            "conn_lease",
            DynamoDbTable {
                table: format!("{}-dsql-conn-lease", cx.project_name),
                region: storage.region.clone(),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );

        d.writeback("infrastructure.storage", "dsql");
        d.writeback("infrastructure.dsql.endpoint", cluster.output("cluster_endpoint"));
        d.writeback("infrastructure.dsql.region", storage.region.clone());
        d.writeback("infrastructure.dsql.rate_limiter_table", rate_limiter.output("table_name"));
        d.writeback("infrastructure.dsql.conn_lease_table", conn_lease.output("table_name"));
    }

    // The engine itself. `ServerConfig` records the deployment's server
    // configuration document (`tokeirad.toml`, a companion of this file) and
    // digests its content; the service's dependency on it means the container
    // mounts the recorded document and follows its digest. The published
    // ports and the AWS region (DSQL mode only) come straight from the
    // configuration.
    let runtime = d.module("runtime", vec![local_state]);
    let server_config = runtime.resource("server_config", ServerConfig {});
    runtime.resource(
        "tokeirad",
        Service {
            image: cfg.tokeirad.image.clone(),
            replicas: cfg.tokeirad.replicas,
            publish: vec![cfg.tokeirad.grpc_port, cfg.tokeirad.metrics_port],
            aws_region: match &cfg.storage {
                Storage::Dsql(storage) => Some(storage.region.clone()),
                _ => None,
            },
            ..Service::EMPTY
        },
        vec![server_config],
    );

    // The observability stack. `ObservabilityConfiguration` renders the
    // backend configuration from the content shipped beside this definition
    // (`observability/`: templates, dashboards, alert rules) with the
    // parameters below; every consumer depends on it and carries its content
    // digest, so a content or parameter edit is a plannable change to each
    // consumer. `depends_on` orders container start; the trailing dependency
    // lists order creation.
    let observability = d.module("observability", vec![local_state, runtime]);
    let o = &cfg.observability;
    let config_files = observability.resource(
        "config_files",
        ObservabilityConfiguration {
            scrape_host: "tokeirad".into(),
            scrape_port: cfg.tokeirad.metrics_port,
            cluster: cx.project_name.clone(),
            deployment: cx.project_name.clone(),
            mimir_remote_write: "http://mimir:9009/api/v1/push".into(),
            loki_push: "http://loki:3100/loki/api/v1/push".into(),
            mimir_http_port: 9009,
            loki_http_port: 3100,
            retention_hours: 168,
        },
    );
    let mimir = observability.resource(
        "mimir",
        Service {
            image: o.mimir.image.clone(),
            replicas: o.mimir.replicas,
            publish: vec![9009],
            volumes: vec![
                Volume::State(StateVolume { sub: "mimir".into(), at: "/data".into() }),
                Volume::Config(ConfigVolume { sub: "mimir.yaml".into(), at: "/etc/mimir/mimir.yaml".into() }),
                Volume::Config(ConfigVolume { sub: "mimir/rules".into(), at: "/data/mimir/rules".into() }),
            ],
            command: vec!["--config.file=/etc/mimir/mimir.yaml".into()],
            ..Service::EMPTY
        },
        vec![config_files],
    );
    let loki = observability.resource(
        "loki",
        Service {
            image: o.loki.image.clone(),
            replicas: o.loki.replicas,
            publish: vec![3100],
            volumes: vec![
                Volume::State(StateVolume { sub: "loki".into(), at: "/loki".into() }),
                Volume::Config(ConfigVolume { sub: "loki.yaml".into(), at: "/etc/loki/loki.yaml".into() }),
            ],
            command: vec!["--config.file=/etc/loki/loki.yaml".into()],
            ..Service::EMPTY
        },
        vec![config_files],
    );
    observability.resource(
        "grafana",
        Service {
            image: o.grafana.image.clone(),
            replicas: o.grafana.replicas,
            publish: vec![o.grafana.port],
            volumes: vec![
                Volume::State(StateVolume { sub: "grafana".into(), at: "/var/lib/grafana".into() }),
                Volume::Config(ConfigVolume { sub: "grafana/provisioning".into(), at: "/etc/grafana/provisioning/".into() }),
                Volume::Config(ConfigVolume { sub: "grafana/dashboards".into(), at: "/var/lib/grafana/dashboards/".into() }),
            ],
            environment: vec![
                Environment { name: "GF_SECURITY_ADMIN_USER".into(), value: "admin".into() },
                Environment { name: "GF_SECURITY_ADMIN_PASSWORD".into(), value: o.grafana.admin_password.clone() },
                Environment { name: "GF_METRICS_ENABLED".into(), value: "true".into() },
            ],
            depends_on: vec!["mimir".into(), "loki".into()],
            ..Service::EMPTY
        },
        vec![config_files, mimir, loki],
    );
    observability.resource(
        "alloy",
        Service {
            image: o.alloy.image.clone(),
            replicas: o.alloy.replicas,
            publish: vec![4317, 4318],
            volumes: vec![
                Volume::DockerSocket,
                Volume::Config(ConfigVolume { sub: "alloy.alloy".into(), at: "/etc/alloy/config.alloy".into() }),
            ],
            command: vec!["run".into(), "/etc/alloy/config.alloy".into()],
            depends_on: vec!["tokeirad".into(), "mimir".into(), "loki".into()],
            ..Service::EMPTY
        },
        vec![config_files, mimir, loki],
    );

    d
}
