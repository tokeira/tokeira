// The Compose deployment definition. The selected frontend evaluates this source into
// one transient structural graph and one typed Compose configuration.

enum DsqlMode {
    Managed,
    Preexisting,
}

struct DsqlStorage {
    region: String,
    mode: DsqlMode,
    endpoint: Option<String>,
    arn: Option<String>,
}

enum Storage {
    InMemory,
    Dsql(DsqlStorage),
}

struct Tokeirad {
    image: String,
    replicas: u32,
    grpc_port: u16,
    metrics_port: u16,
}

struct Backend {
    image: String,
    replicas: u32,
}

struct Grafana {
    image: String,
    replicas: u32,
    port: u16,
    admin_password: String,
}

struct Observability {
    mimir: Backend,
    loki: Backend,
    grafana: Grafana,
    alloy: Backend,
}

struct Compose {
    #[create]
    storage: Storage,
    tokeirad: Tokeirad,
    observability: Observability,
}

struct Environment {
    name: String,
    value: String,
}

struct StateVolume {
    sub: String,
    at: String,
}

struct ConfigVolume {
    sub: String,
    at: String,
}

enum Volume {
    State(StateVolume),
    Config(ConfigVolume),
    DockerSocket,
}

fn config() -> Compose {
    Compose {
        storage: Storage::InMemory,
        tokeirad: Tokeirad {
            image: "tokeirad:latest".into(),
            replicas: 1,
            grpc_port: 7233,
            metrics_port: 9090,
        },
        observability: Observability {
            mimir: Backend { image: "grafana/mimir:3.0.6".into(), replicas: 1 },
            loki: Backend { image: "grafana/loki:3.7.1".into(), replicas: 1 },
            grafana: Grafana {
                image: "grafana/grafana-oss:12.4.3".into(),
                replicas: 1,
                port: 3000,
                admin_password: "admin".into(),
            },
            alloy: Backend { image: "grafana/alloy:v1.16.0".into(), replicas: 1 },
        },
    }
}

fn deployment(cfg: Compose, cx: Context) -> Deployment {
    let d = Deployment::new(&["default"]);

    let local_state = d.module("local_state", vec![]);
    local_state.resource("dir", LocalStateDir {});

    if let Storage::Dsql(storage) = &cfg.storage {
        let dsql = d.module("dsql", vec![local_state]);
        let cluster = dsql.resource(
            "cluster",
            DsqlCluster {
                identity: format!("{}-compose", cx.project_name),
                region: storage.region.clone(),
                mode: storage.mode.clone(),
                endpoint: storage.endpoint.clone(),
                arn: storage.arn.clone(),
            },
        );
        let rate_limiter = dsql.resource(
            "rate_limiter",
            DynamoDbTable {
                table: format!("{}-dsql-rate-limiter", cx.project_name),
                region: storage.region.clone(),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );
        let conn_lease = dsql.resource(
            "conn_lease",
            DynamoDbTable {
                table: format!("{}-dsql-conn-lease", cx.project_name),
                region: storage.region.clone(),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );

        d.writeback("infrastructure.storage", "dsql");
        d.writeback("infrastructure.dsql.endpoint", cluster.output("cluster_endpoint"));
        d.writeback("infrastructure.dsql.region", storage.region.clone());
        d.writeback("infrastructure.dsql.rate_limiter_table", rate_limiter.output("table_name"));
        d.writeback("infrastructure.dsql.conn_lease_table", conn_lease.output("table_name"));
    }

    let runtime = d.module("runtime", vec![local_state]);
    let server_config = runtime.resource("server_config", ServerConfig {});
    runtime.resource(
        "tokeirad",
        Service {
            image: cfg.tokeirad.image.clone(),
            replicas: cfg.tokeirad.replicas,
            publish: vec![cfg.tokeirad.grpc_port, cfg.tokeirad.metrics_port],
            aws_region: match &cfg.storage {
                Storage::Dsql(storage) => Some(storage.region.clone()),
                _ => None,
            },
            ..Service::EMPTY
        },
        vec![server_config],
    );

    let observability = d.module("observability", vec![local_state, runtime]);
    let o = &cfg.observability;
    let config_files = observability.resource(
        "config_files",
        ObservabilityConfiguration {
            scrape_host: "tokeirad".into(),
            scrape_port: cfg.tokeirad.metrics_port,
            cluster: cx.project_name.clone(),
            deployment: cx.project_name.clone(),
            mimir_remote_write: "http://mimir:9009/api/v1/push".into(),
            loki_push: "http://loki:3100/loki/api/v1/push".into(),
            mimir_http_port: 9009,
            loki_http_port: 3100,
            retention_hours: 168,
        },
    );
    let mimir = observability.resource(
        "mimir",
        Service {
            image: o.mimir.image.clone(),
            replicas: o.mimir.replicas,
            publish: vec![9009],
            volumes: vec![
                Volume::State(StateVolume { sub: "mimir".into(), at: "/data".into() }),
                Volume::Config(ConfigVolume { sub: "mimir.yaml".into(), at: "/etc/mimir/mimir.yaml".into() }),
                Volume::Config(ConfigVolume { sub: "mimir/rules".into(), at: "/data/mimir/rules".into() }),
            ],
            command: vec!["--config.file=/etc/mimir/mimir.yaml".into()],
            ..Service::EMPTY
        },
        vec![config_files],
    );
    let loki = observability.resource(
        "loki",
        Service {
            image: o.loki.image.clone(),
            replicas: o.loki.replicas,
            publish: vec![3100],
            volumes: vec![
                Volume::State(StateVolume { sub: "loki".into(), at: "/loki".into() }),
                Volume::Config(ConfigVolume { sub: "loki.yaml".into(), at: "/etc/loki/loki.yaml".into() }),
            ],
            command: vec!["--config.file=/etc/loki/loki.yaml".into()],
            ..Service::EMPTY
        },
        vec![config_files],
    );
    observability.resource(
        "grafana",
        Service {
            image: o.grafana.image.clone(),
            replicas: o.grafana.replicas,
            publish: vec![o.grafana.port],
            volumes: vec![
                Volume::State(StateVolume { sub: "grafana".into(), at: "/var/lib/grafana".into() }),
                Volume::Config(ConfigVolume { sub: "grafana/provisioning".into(), at: "/etc/grafana/provisioning/".into() }),
                Volume::Config(ConfigVolume { sub: "grafana/dashboards".into(), at: "/var/lib/grafana/dashboards/".into() }),
            ],
            environment: vec![
                Environment { name: "GF_SECURITY_ADMIN_USER".into(), value: "admin".into() },
                Environment { name: "GF_SECURITY_ADMIN_PASSWORD".into(), value: o.grafana.admin_password.clone() },
                Environment { name: "GF_METRICS_ENABLED".into(), value: "true".into() },
            ],
            depends_on: vec!["mimir".into(), "loki".into()],
            ..Service::EMPTY
        },
        vec![config_files, mimir, loki],
    );
    observability.resource(
        "alloy",
        Service {
            image: o.alloy.image.clone(),
            replicas: o.alloy.replicas,
            publish: vec![4317, 4318],
            volumes: vec![
                Volume::DockerSocket,
                Volume::Config(ConfigVolume { sub: "alloy.alloy".into(), at: "/etc/alloy/config.alloy".into() }),
            ],
            command: vec!["run".into(), "/etc/alloy/config.alloy".into()],
            depends_on: vec!["tokeirad".into(), "mimir".into(), "loki".into()],
            ..Service::EMPTY
        },
        vec![config_files, mimir, loki],
    );

    d
}
