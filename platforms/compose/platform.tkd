// The platform's model of itself: the Compose configuration shape and the
// companion types the deployment's services mount and set. This part is the
// shared vocabulary — the root and every other part take what they need
// from it, and revisions edit values against exactly these shapes. Fields
// marked `#[create]` are fixed at deployment creation — an edit that
// changes one is refused at retarget check, because it names a different
// deployment rather than a change to this one.

// How the deployment stores workflow state. `Managed` creates and owns an
// Aurora DSQL cluster; `Preexisting` adopts one the operator already runs.
pub enum DsqlMode {
    Managed,
    Preexisting,
}

// DSQL storage settings. `endpoint` and `arn` identify an adopted cluster
// and accompany `Preexisting` only; a managed cluster derives its identity
// at creation. The `DsqlCluster` kind refuses inconsistent combinations at
// the authoring site.
pub struct DsqlStorage {
    pub region: String,
    pub mode: DsqlMode,
    pub endpoint: Option<String>,
    pub arn: Option<String>,
}

// The storage choice: keep workflow state in memory (development), or on
// Aurora DSQL plus its coordination tables (durable).
pub enum Storage {
    InMemory,
    Dsql(DsqlStorage),
}

// The tokeirad server container: image, capacity, and the two published
// ports (Temporal-compatible gRPC, Prometheus metrics).
pub struct Tokeirad {
    pub image: String,
    pub replicas: u32,
    pub grpc_port: u16,
    pub metrics_port: u16,
}

// One observability backend container: image and capacity.
pub struct Backend {
    pub image: String,
    pub replicas: u32,
}

// Grafana: image, capacity, published HTTP port, and the initial
// administrator password seeded at first start.
pub struct Grafana {
    pub image: String,
    pub replicas: u32,
    pub port: u16,
    pub admin_password: String,
}

// The observability stack: Mimir (metrics), Loki (logs), Grafana
// (dashboards), Alloy (collection).
pub struct Observability {
    pub mimir: Backend,
    pub loki: Backend,
    pub grafana: Grafana,
    pub alloy: Backend,
}

// The aws provider's deployment-level attributes: the deployed context,
// materialized under the provider's namespace. Resource-attached attributes
// take precedence by the provider's own rule.
pub struct Aws {
    pub region: String,
}

// The complete Compose configuration — the shape `config()` returns and the
// value every later revision edits. `storage` and `aws` are create-time:
// switching a deployment's storage or relocating its region is a different
// deployment.
pub struct Compose {
    #[create]
    pub storage: Storage,
    #[create]
    pub aws: Aws,
    pub tokeirad: Tokeirad,
    pub observability: Observability,
}

// One container environment variable.
pub struct Environment {
    pub name: String,
    pub value: String,
}

// A durable-data mount: `sub` names a subdirectory of the deployment's
// state root, mounted into the container at `at`. State volumes survive
// container replacement.
pub struct StateVolume {
    pub sub: String,
    pub at: String,
}

// A rendered-configuration mount: `sub` names a file or directory under the
// deployment's rendered-config root, mounted at `at`. The content is
// produced by the configuration resources; its digest fences every
// consumer, so a content change is a visible container change.
pub struct ConfigVolume {
    pub sub: String,
    pub at: String,
}

// The mount families a service may declare. `DockerSocket` grants the
// container the host's Docker socket — used only by the collector, which
// discovers the other containers through it.
pub enum Volume {
    State(StateVolume),
    Config(ConfigVolume),
    DockerSocket,
}
