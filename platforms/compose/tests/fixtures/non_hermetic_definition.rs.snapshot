//! The OPERATOR's deployment definition — compiled Rust for now (the `syn`-
//! interpreted form is the deferred foundation). It may name ONLY the author's
//! vocabulary ([`crate::builder`] + [`crate::kinds`]), nothing of the engine
//! directly.
//!
//! `config()` is the operator surface; `deployment(cfg, cx)` is the structure.
//! Both reproduce `platforms/compose/src` faithfully (the playground reproduces
//! the engine's compose platform, warts and all, to prove fidelity).

use crate::{
    builder::Deployment,
    context::Cx,
    kinds::{
        DsqlCluster, DsqlMode as KindMode, DynamoDbTable, LocalStateDir, ObservabilityConfigFiles,
        Service,
    },
};

// ── Config: the operator surface ────────────────────────────────────────────

/// DSQL ownership. `Preexisting` *carries* the identity of an adopted cluster, so
/// "preexisting DSQL requires an endpoint" is **structural** — illegal states are
/// unrepresentable, no `#[require]` validation needed (review feedback).
pub enum DsqlMode {
    Managed,
    Preexisting { endpoint: String, arn: String },
}

/// Storage backend — a create-time choice.
pub enum Storage {
    InMemory,
    Dsql { region: String, mode: DsqlMode },
}

pub struct Tokeirad {
    pub image: String,
    pub replicas: u32,
    pub grpc_port: u16,
    pub metrics_port: u16,
}

pub struct Backend {
    pub image: String,
    pub replicas: u32,
}

pub struct Grafana {
    pub image: String,
    pub replicas: u32,
    pub port: u16,
    pub admin_password: String,
}

pub struct Observability {
    pub mimir: Backend,
    pub loki: Backend,
    pub grafana: Grafana,
    pub alloy: Backend,
}

/// The operator surface — what an operator edits.
pub struct Compose {
    pub storage: Storage,
    pub tokeirad: Tokeirad,
    pub observability: Observability,
}

/// The default config the operator edits (defaults mirror `ComposeConfig`).
pub fn config() -> Compose {
    Compose {
        storage: Storage::InMemory,
        tokeirad: Tokeirad {
            image: "tokeirad:latest".into(),
            replicas: 1,
            grpc_port: 7233,
            metrics_port: 9090,
        },
        observability: Observability {
            mimir: Backend { image: "grafana/mimir:3.0.6".into(), replicas: 1 },
            loki: Backend { image: "grafana/loki:3.7.1".into(), replicas: 1 },
            grafana: Grafana {
                image: "grafana/grafana-oss:12.4.3".into(),
                replicas: 1,
                port: 3000,
                admin_password: "admin".into(),
            },
            alloy: Backend { image: "grafana/alloy:v1.16.0".into(), replicas: 1 },
        },
    }
}

// ── Structure: the deployment ───────────────────────────────────────────────

/// Build the deployment from config + context. Reproduces
/// `platforms/compose/src` (compose_services / modules.rs / collect_writeback).
pub fn deployment(cfg: &Compose, cx: &Cx) -> Deployment {
    let state_dir = cx.deployment_dir.join(".tokeira-state");
    let config_dir = cx.deployment_dir.join("config");
    let vol = |host: std::path::PathBuf, container: &str| format!("{}:{}", host.display(), container);

    let mut d = Deployment::new(&["default"]);

    // bootstrap state
    let local_state = d.module("local_state", &[]);
    d.resource(&local_state, "dir", LocalStateDir);

    // dsql — only under persistent storage
    if let Storage::Dsql { region, mode } = &cfg.storage {
        let dsql = d.module("dsql", &["local_state"]);
        let (kind_mode, endpoint, arn) = match mode {
            DsqlMode::Managed => (KindMode::Managed, None, None),
            DsqlMode::Preexisting { endpoint, arn } => {
                (KindMode::Preexisting, Some(endpoint.clone()), Some(arn.clone()))
            }
        };
        let cluster = d.resource(
            &dsql,
            "cluster",
            DsqlCluster { region: region.clone(), mode: kind_mode, endpoint, arn },
        );
        let rate_limiter = d.resource(
            &dsql,
            "rate_limiter",
            DynamoDbTable {
                table: format!("{}-dsql-rate-limiter", cx.project_name),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );
        let conn_lease = d.resource(
            &dsql,
            "conn_lease",
            DynamoDbTable {
                table: format!("{}-dsql-conn-lease", cx.project_name),
                hash_key: "pk".into(),
                ttl: Some("ttl_epoch".into()),
            },
        );

        // writeback into the server config (collect_writeback analog)
        d.writeback("infrastructure.storage", "dsql");
        d.writeback("infrastructure.dsql.endpoint", cluster.output("cluster_endpoint"));
        d.writeback("infrastructure.dsql.region", region.clone());
        d.writeback("infrastructure.dsql.rate_limiter_table", rate_limiter.output("table_name"));
        d.writeback("infrastructure.dsql.conn_lease_table", conn_lease.output("table_name"));
    }

    // observability — config files + the four backend services
    let observability = d.module("observability", &["local_state"]);
    let o = &cfg.observability;
    d.resource(
        &observability,
        "config_files",
        ObservabilityConfigFiles {
            scrape_host: "tokeirad".into(),
            scrape_port: cfg.tokeirad.metrics_port,
            cluster: cx.project_name.clone(),
            deployment: cx.project_name.clone(),
            mimir_remote_write: "http://mimir:9009/api/v1/push".into(),
            loki_push: "http://loki:3100/loki/api/v1/push".into(),
            mimir_http_port: 9009,
            loki_http_port: 3100,
            retention_hours: 168,
        },
    );

    d.service(
        &observability,
        "mimir",
        Service {
            image: o.mimir.image.clone(),
            replicas: o.mimir.replicas,
            publish: vec![9009],
            volumes: vec![
                vol(state_dir.join("mimir"), "/data"),
                vol(config_dir.join("mimir.yaml"), "/etc/mimir/mimir.yaml"),
                vol(config_dir.join("mimir/rules"), "/data/mimir/rules"),
            ],
            env: vec![],
            command: vec!["--config.file=/etc/mimir/mimir.yaml".into()],
            needs: vec![],
        },
    );
    d.service(
        &observability,
        "loki",
        Service {
            image: o.loki.image.clone(),
            replicas: o.loki.replicas,
            publish: vec![3100],
            volumes: vec![
                vol(state_dir.join("loki"), "/loki"),
                vol(config_dir.join("loki.yaml"), "/etc/loki/loki.yaml"),
            ],
            env: vec![],
            command: vec!["--config.file=/etc/loki/loki.yaml".into()],
            needs: vec![],
        },
    );
    d.service(
        &observability,
        "grafana",
        Service {
            image: o.grafana.image.clone(),
            replicas: o.grafana.replicas,
            publish: vec![o.grafana.port],
            volumes: vec![
                vol(state_dir.join("grafana"), "/var/lib/grafana"),
                vol(config_dir.join("grafana/provisioning"), "/etc/grafana/provisioning/"),
                vol(config_dir.join("grafana/dashboards"), "/var/lib/grafana/dashboards/"),
            ],
            env: vec![
                ("GF_SECURITY_ADMIN_USER".into(), "admin".into()),
                ("GF_SECURITY_ADMIN_PASSWORD".into(), o.grafana.admin_password.clone()),
                ("GF_METRICS_ENABLED".into(), "true".into()),
            ],
            command: vec![],
            needs: vec!["mimir".into(), "loki".into()],
        },
    );
    d.service(
        &observability,
        "alloy",
        Service {
            image: o.alloy.image.clone(),
            replicas: o.alloy.replicas,
            publish: vec![4317, 4318],
            volumes: vec![
                "/var/run/docker.sock:/var/run/docker.sock".into(),
                vol(config_dir.join("alloy.alloy"), "/etc/alloy/config.alloy"),
            ],
            env: vec![],
            command: vec!["run".into(), "/etc/alloy/config.alloy".into()],
            needs: vec!["tokeirad".into(), "mimir".into(), "loki".into()],
        },
    );

    // runtime — tokeirad (with the conditional config mount + DSQL AWS edge,
    // reproduced from compose.rs, std::env and the toml-exists check included).
    let runtime = d.module("runtime", &["local_state"]);
    let mut volumes: Vec<String> = Vec::new();
    let mut env: Vec<(String, String)> = Vec::new();
    let tokeirad_toml = cx.deployment_dir.join("tokeirad.toml");
    if tokeirad_toml.exists() {
        volumes.push(vol(tokeirad_toml, "/etc/tokeira/tokeirad.toml:ro"));
        env.push(("TOKEIRA_CONFIG".into(), "/etc/tokeira/tokeirad.toml".into()));
    }
    if let Storage::Dsql { region, .. } = &cfg.storage {
        let home = std::env::var("HOME").unwrap_or_else(|_| "/root".into());
        volumes.push(format!("{home}/.aws:/home/nonroot/.aws:ro"));
        env.push(("HOME".into(), "/home/nonroot".into()));
        env.push(("AWS_REGION".into(), region.clone()));
        for key in [
            "AWS_PROFILE",
            "AWS_ACCESS_KEY_ID",
            "AWS_SECRET_ACCESS_KEY",
            "AWS_SESSION_TOKEN",
            "AWS_ROLE_ARN",
        ] {
            if let Ok(value) = std::env::var(key) {
                env.push((key.to_string(), value));
            }
        }
    }
    d.service(
        &runtime,
        "tokeirad",
        Service {
            image: cfg.tokeirad.image.clone(),
            replicas: cfg.tokeirad.replicas,
            publish: vec![cfg.tokeirad.grpc_port, cfg.tokeirad.metrics_port],
            volumes,
            env,
            command: vec![],
            needs: vec![],
        },
    );

    d
}
