# Guarded-dispatch example, carried from the monty-tkdp spike: a guard admits
# the authored region, its fallback case pins a default region, and the
# InMemory variant swaps the storage module entirely.

from dataclasses import dataclass

from tokeira import Context, Deployment, DsqlCluster, LocalStateDir


@dataclass
class Managed:
    pass


@dataclass
class InMemory:
    pass


@dataclass
class ManagedDsql:
    region: str


@dataclass
class Minimal:
    storage: InMemory | ManagedDsql


def config() -> Minimal:
    return Minimal(storage=ManagedDsql(region="eu-west-2"))


def deployment(cfg: Minimal, cx: Context) -> Deployment:
    d = Deployment(["default"])

    match cfg.storage:
        case ManagedDsql(region=region) if region != "":
            dsql = d.module("dsql")
            dsql.resource(
                "cluster",
                DsqlCluster(identity=cx.project_name, region=region, mode=Managed()),
            )
        case ManagedDsql(region=_):
            fallback = d.module("dsql")
            fallback.resource(
                "cluster",
                DsqlCluster(identity=cx.project_name, region="eu-west-1", mode=Managed()),
            )
        case InMemory():
            state = d.module("local_state")
            state.resource("dir", LocalStateDir())

    return d
