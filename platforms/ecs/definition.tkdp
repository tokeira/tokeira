# The Python root for the modular ECS definition. It owns operator defaults
# and cross-part wiring; focused companion modules own repeated assemblies
# and resources that do not need to expose handles across module boundaries.

import cluster
import dsql
import helpers
import images
import networking
import observability
import remote_state
import services

from dataclasses import dataclass

from platform import (
    Alb,
    Aws,
    BuildImage,
    Capacity,
    CapacityPlane,
    Cluster,
    DaemonPolicy,
    Ecs,
    Http2,
    Https,
    Images,
    Managed as ManagedDsql,
    MirrorImage,
    Networking,
    Observability,
    Preexisting as PreexistingDsql,
    ReplicaPolicy,
    Services,
)
from tokeira import (
    AlbTargetGroup,
    Context,
    Deployment,
    DsqlIamRole,
    DynamoDbTable,
    EcsExecutionRole,
    EcsTaskRole,
    SecretsManagerSecret,
    SecurityGroup,
    ServerConfig,
    Vpc,
)


@dataclass
class Managed:
    # Provider vocabulary for an owned DSQL task role.
    region: str
    role_name: str
    policy_name: str
    action: str


@dataclass
class Preexisting:
    # Provider vocabulary for an adopted DSQL task role.
    role_arn: str


@dataclass
class GeneratedPasswordJson:
    # Provider vocabulary for the generated Grafana credential document.
    username: str
    password_length: int


def config() -> Ecs:
    # This is the operator-editable surface. Image versions are immutable
    # pins; image mirror/push writes deployment-local registry references
    # before the deploy plane is admitted.
    return Ecs(
        environment="dev",
        aws=Aws(region="eu-west-2"),
        cluster=Cluster(
            name="tokeira",
            service_connect_namespace="tokeira.internal",
        ),
        networking=Networking(
            vpc_cidr="10.42.0.0/16",
            availability_zones=["eu-west-2a", "eu-west-2b", "eu-west-2c"],
            private_dns_zone="tokeira.internal",
        ),
        dsql=ManagedDsql(),
        images=Images(
            tokeirad=BuildImage(
                name="tokeirad", repository="tokeirad", tag="latest"
            ),
            autoscaler=BuildImage(
                name="tokeira-autoscaler",
                repository="tokeira-autoscaler",
                tag="latest",
            ),
            mimir=MirrorImage(
                name="grafana-mimir",
                repository="mimir",
                tag="3.2.0",
                upstream_ref="grafana/mimir:3.2.0",
            ),
            loki=MirrorImage(
                name="grafana-loki",
                repository="loki",
                tag="3.7.6",
                upstream_ref="grafana/loki:3.7.6",
            ),
            grafana=MirrorImage(
                name="grafana",
                repository="grafana",
                tag="12.4.9",
                upstream_ref="grafana/grafana:12.4.9",
            ),
            alloy=MirrorImage(
                name="grafana-alloy",
                repository="alloy",
                tag="v1.19.0",
                upstream_ref="grafana/alloy:v1.19.0",
            ),
            aws_cli=MirrorImage(
                name="aws-cli",
                repository="aws-cli",
                tag="2.17.0",
                upstream_ref="amazon/aws-cli:2.17.0",
            ),
            busybox=MirrorImage(
                name="busybox",
                repository="busybox",
                tag="1.36",
                upstream_ref="busybox:1.36",
            ),
        ),
        services=Services(
            edge_api=ReplicaPolicy(
                replicas=2,
                cpu=1024,
                memory_mb=2048,
            ),
            edge_poll=ReplicaPolicy(
                replicas=2,
                cpu=1024,
                memory_mb=2048,
            ),
            runtime=DaemonPolicy(
                cpu=2048,
                memory_mb=4096,
            ),
            projection=ReplicaPolicy(
                replicas=2,
                cpu=1024,
                memory_mb=2048,
            ),
            controller=ReplicaPolicy(
                replicas=1,
                cpu=512,
                memory_mb=1024,
            ),
            autoscaler=ReplicaPolicy(
                replicas=1,
                cpu=512,
                memory_mb=1024,
            ),
            admin=ReplicaPolicy(
                replicas=0,
                cpu=512,
                memory_mb=1024,
            ),
        ),
        capacity=Capacity(
            edge_api=CapacityPlane(
                instance_type="c8g.large", min=1, desired=2, max=8
            ),
            edge_poll=CapacityPlane(
                instance_type="c8g.large", min=1, desired=2, max=8
            ),
            runtime=CapacityPlane(
                instance_type="c8g.xlarge", min=1, desired=2, max=8
            ),
            projection=CapacityPlane(
                instance_type="c8g.large", min=1, desired=2, max=8
            ),
            control=CapacityPlane(
                instance_type="c8g.large", min=1, desired=1, max=4
            ),
            mimir=CapacityPlane(
                instance_type="c8g.large", min=1, desired=1, max=1
            ),
            loki=CapacityPlane(
                instance_type="c8g.large", min=1, desired=1, max=1
            ),
            grafana=CapacityPlane(
                instance_type="c8g.large", min=1, desired=1, max=1
            ),
        ),
        alb=Alb(
            protocol=Http2(),
            health_check_path="/health",
            health_check_interval_secs=30,
        ),
        observability=Observability(
            mimir=ReplicaPolicy(
                replicas=1,
                cpu=1024,
                memory_mb=2048,
            ),
            loki=ReplicaPolicy(
                replicas=1,
                cpu=1024,
                memory_mb=2048,
            ),
            grafana=ReplicaPolicy(
                replicas=1,
                cpu=512,
                memory_mb=1024,
            ),
            loki_query_url="http://localhost:3100",
        ),
    )


def deployment(cfg: Ecs, cx: Context) -> Deployment:
    d = Deployment(["default"])

    # State admission is the ordering root everything else stands on. The
    # shell already opened the selected local/S3 stores; the module must not
    # re-author that deployment-level location as ECS desired state.
    remote_state_module = d.module("remote_state")
    remote_state.define(d, cfg, cx, remote_state_module)

    # Image repositories depend only on bootstrap state and are available
    # before any workload manifest is realized.
    images_module = d.module("images", [remote_state_module])
    images.define(d, cfg, cx, images_module)

    # Shared network handles are rooted here because DSQL, cluster, and
    # service parts all depend on them.
    networking_module = d.module("networking", [remote_state_module])
    vpc = networking_module.resource(
        "vpc",
        Vpc(
            region=cfg.aws.region,
            cidr=cfg.networking.vpc_cidr,
            availability_zones=cfg.networking.availability_zones,
        ),
    )
    endpoint_sg = networking_module.resource(
        "sg-vpc-endpoints",
        SecurityGroup(
            region=cfg.aws.region,
            name="vpc-endpoints",
            description="Tokeira ECS VPC endpoints security group",
            ingress=[
                {
                    "description": "private VPC endpoints traffic",
                    "protocol": "tcp",
                    "from_port": 443,
                    "to_port": 443,
                    "source": cfg.networking.vpc_cidr,
                }
            ],
        ),
        [vpc],
    )
    runtime_sg = networking_module.resource(
        "sg-runtime",
        SecurityGroup(
            region=cfg.aws.region,
            name="runtime",
            description="Tokeira ECS runtime services security group",
            ingress=[
                {
                    "description": "private VPC runtime services traffic",
                    "protocol": "tcp",
                    "from_port": 7241,
                    "to_port": 7241,
                    "source": cfg.networking.vpc_cidr,
                }
            ],
        ),
        [vpc],
    )
    edge_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "edge",
        "edge services",
        7233,
    )
    projection_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "projection",
        "projection services",
        7242,
    )
    control_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "control",
        "control services",
        7240,
    )
    mimir_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "mimir",
        "Mimir",
        9009,
    )
    loki_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "loki",
        "Loki",
        3100,
    )
    grafana_sg = helpers.edge_group(
        networking_module,
        vpc,
        cfg.aws.region,
        cfg.networking.vpc_cidr,
        "grafana",
        "Grafana",
        3000,
    )
    for short, service in [
        ("ecs", "ecs"),
        ("ecs-agent", "ecs-agent"),
        ("ecs-telemetry", "ecs-telemetry"),
        ("ecr-api", "ecr.api"),
        ("ecr-dkr", "ecr.dkr"),
        ("autoscaling", "autoscaling"),
        ("servicediscovery", "servicediscovery"),
        ("ssm", "ssm"),
        ("ssmmessages", "ssmmessages"),
        ("ec2messages", "ec2messages"),
        ("secretsmanager", "secretsmanager"),
    ]:
        helpers.interface(
            networking_module,
            vpc,
            endpoint_sg,
            cfg.aws.region,
            short,
            service,
        )
    edge_api_tg = networking_module.resource(
        "tg-edge-api",
        AlbTargetGroup(
            name="tokeira-edge-api",
            port=7233,
            health_check_path=cfg.alb.health_check_path,
            health_check_interval_secs=cfg.alb.health_check_interval_secs,
        ),
        [vpc],
    )
    edge_poll_tg = networking_module.resource(
        "tg-edge-poll",
        AlbTargetGroup(
            name="tokeira-edge-poll",
            port=7234,
            health_check_path=cfg.alb.health_check_path,
            health_check_interval_secs=cfg.alb.health_check_interval_secs,
        ),
        [vpc],
    )
    networking.define(
        d,
        cfg,
        cx,
        networking_module,
        vpc,
        endpoint_sg,
        edge_api_tg,
        edge_poll_tg,
    )

    # DSQL publishes identical resource and writeback identities in managed
    # and adopted modes.
    dsql_module = d.module("dsql", [networking_module])
    dsql_cluster = dsql.define(d, cfg, cx, dsql_module, vpc, endpoint_sg)
    rate_limiter = dsql_module.resource(
        "rate_limiter",
        DynamoDbTable(
            table=cx.project_name + "-dsql-rate-limiter",
            region=cfg.aws.region,
            hash_key="pk",
            ttl="ttl_epoch",
        ),
    )
    conn_lease = dsql_module.resource(
        "conn_lease",
        DynamoDbTable(
            table=cx.project_name + "-dsql-conn-lease",
            region=cfg.aws.region,
            hash_key="pk",
            ttl="ttl_epoch",
        ),
    )
    d.writeback("infrastructure.storage", "dsql")
    d.writeback(
        "infrastructure.dsql.endpoint",
        dsql_cluster.output("cluster_endpoint"),
    )
    d.writeback("infrastructure.dsql.region", cfg.aws.region)
    d.writeback(
        "infrastructure.dsql.rate_limiter_table",
        rate_limiter.output("table_name"),
    )
    d.writeback(
        "infrastructure.dsql.conn_lease_table",
        conn_lease.output("table_name"),
    )
    match cfg.dsql:
        case ManagedDsql():
            runtime_role = dsql_module.resource(
                "runtime_role",
                DsqlIamRole(
                    id="dsql:runtime-role",
                    mode=Managed(
                        region=cfg.aws.region,
                        role_name=cx.project_name + "-dsql-runtime",
                        policy_name="dsql-runtime",
                        action="dsql:DbConnect",
                    ),
                ),
                [dsql_cluster],
            )
            admin_role = dsql_module.resource(
                "admin_role",
                DsqlIamRole(
                    id="dsql:admin-role",
                    mode=Managed(
                        region=cfg.aws.region,
                        role_name=cx.project_name + "-dsql-admin",
                        policy_name="dsql-admin",
                        action="dsql:DbConnectAdmin",
                    ),
                ),
                [dsql_cluster],
            )
        case PreexistingDsql(
            endpoint=_,
            arn=_,
            management_endpoint_id=_,
            connection_endpoint_id=_,
            runtime_role_arn=runtime_role_arn,
            admin_role_arn=admin_role_arn,
        ):
            runtime_role = dsql_module.resource(
                "runtime_role",
                DsqlIamRole(
                    id="dsql:runtime-role",
                    mode=Preexisting(role_arn=runtime_role_arn),
                ),
            )
            admin_role = dsql_module.resource(
                "admin_role",
                DsqlIamRole(
                    id="dsql:admin-role",
                    mode=Preexisting(role_arn=admin_role_arn),
                ),
            )
    d.writeback(
        "infrastructure.dsql.runtime_role_arn",
        runtime_role.output("role_arn"),
    )
    d.writeback(
        "infrastructure.dsql.admin_role_arn",
        admin_role.output("role_arn"),
    )

    # Capacity is isolated by workload family. The helper preserves one
    # role/profile/template/ASG/provider assembly across all planes.
    cluster_module = d.module("cluster", [dsql_module])
    ecs_cluster = cluster.define(d, cfg, cx, cluster_module)
    for name, workload, policy, protect in [
        ("cp-edge-api", "edge-api", cfg.capacity.edge_api, False),
        ("cp-edge-poll", "edge-poll", cfg.capacity.edge_poll, False),
        ("cp-runtime", "runtime", cfg.capacity.runtime, True),
        ("cp-projection", "projection", cfg.capacity.projection, False),
        ("cp-control", "control", cfg.capacity.control, False),
        ("cp-mimir", "mimir", cfg.capacity.mimir, False),
        ("cp-loki", "loki", cfg.capacity.loki, False),
        ("cp-grafana", "grafana", cfg.capacity.grafana, False),
    ]:
        helpers.plane(
            cluster_module,
            cx,
            vpc,
            runtime_sg,
            ecs_cluster,
            cfg.aws.region,
            cfg.cluster.name,
            name,
            workload,
            policy,
            protect,
        )

    # Observability owns backend storage, credentials, roles, rendered Alloy
    # parameters, and companion artifacts. Workloads are declared later in
    # the services module and depend on these handles.
    observability_module = d.module("observability", [cluster_module, images_module])
    mimir_task_role = observability_module.resource(
        "mimir_task_role",
        EcsTaskRole(service="tokeira-mimir", region=cfg.aws.region),
    )
    loki_task_role = observability_module.resource(
        "loki_task_role",
        EcsTaskRole(service="tokeira-loki", region=cfg.aws.region),
    )
    grafana_task_role = observability_module.resource(
        "grafana_task_role",
        EcsTaskRole(service="tokeira-grafana", region=cfg.aws.region),
    )
    grafana_execution_role = observability_module.resource(
        "grafana_execution_role",
        EcsExecutionRole(service="tokeira-grafana", region=cfg.aws.region),
    )
    observability.define(d, cfg, cx, observability_module)
    observability_module.resource(
        "grafana_admin_secret",
        SecretsManagerSecret(
            region=cfg.aws.region,
            name="tokeira/grafana/admin",
            source=GeneratedPasswordJson(username="admin", password_length=32),
            recovery_window_days=7,
        ),
    )
    for service in [
        "tokeira-edge-api",
        "tokeira-edge-poll",
        "tokeira-runtime",
        "tokeira-projection",
        "tokeira-controller",
        "tokeira-autoscaler",
        "tokeira-admin",
        "tokeira-mimir",
        "tokeira-loki",
        "tokeira-grafana",
    ]:
        helpers.alloy(observability_module, cfg, service)

    # The deploy plane owns all workloads. ServerConfig is a stable graph
    # identity whose content and digest are resolved into the five binaries
    # that consume TokeiraConfig.
    services_module = d.module("services", [observability_module, images_module])
    server_config = services_module.resource("server_config", ServerConfig())
    services.define(cfg, services_module, vpc, control_sg)
    edge_api_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-edge-api"
    )
    edge_poll_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-edge-poll"
    )
    runtime_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-runtime"
    )
    projection_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-projection"
    )
    controller_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-controller"
    )
    admin_task_role = helpers.task_role(
        services_module, cfg.aws.region, "tokeira-admin"
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-edge-api",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.edge_api,
        [edge_api_task_role, vpc, edge_sg, edge_api_tg, server_config],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-edge-poll",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.edge_poll,
        [edge_poll_task_role, vpc, edge_sg, edge_poll_tg, server_config],
    )
    helpers.daemon(
        services_module,
        cfg,
        "tokeira-runtime",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.runtime,
        [runtime_task_role, vpc, runtime_sg, server_config],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-projection",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.projection,
        [projection_task_role, vpc, projection_sg, server_config],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-controller",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.controller,
        [controller_task_role, vpc, control_sg],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-admin",
        cfg.images.tokeirad.repository + ":" + cfg.images.tokeirad.tag,
        cfg.services.admin,
        [admin_task_role, vpc, control_sg, server_config],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-mimir",
        cfg.images.mimir.repository + ":" + cfg.images.mimir.tag,
        cfg.observability.mimir,
        [mimir_task_role, vpc, mimir_sg],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-loki",
        cfg.images.loki.repository + ":" + cfg.images.loki.tag,
        cfg.observability.loki,
        [loki_task_role, vpc, loki_sg],
    )
    helpers.replica(
        services_module,
        cfg,
        "tokeira-grafana",
        cfg.images.grafana.repository + ":" + cfg.images.grafana.tag,
        cfg.observability.grafana,
        [grafana_task_role, grafana_execution_role, vpc, grafana_sg],
    )

    return d
