// The ECS deployment, as the root document of a ten-document definition.
// The root reads as the wiring diagram: every module and its dependencies
// are declared here, along with the resources more than one part stands on —
// the VPC, the endpoint and runtime security groups. Module contents live in
// the nine companion parts; the configuration model lives in `platform`.
// `definition.tkdp` is a peer authoring projection: tests require both roots
// to produce the same config, graph, writebacks, and infrastructure manifests.

mod cluster;
mod dsql;
mod helpers;
mod images;
mod networking;
mod observability;
mod platform;
mod remote_state;
mod services;

use platform::{
    Alb, AlbProtocol, Aws, BuildImage, Capacity, CapacityPlane, Cluster, DaemonPolicy, Dsql, Ecs,
    GeneratedPassword, HttpsAlb, Images, IngressRule, ManagedRole, MirrorImage, Networking,
    Observability, PreexistingRole, ReplicaPolicy, RoleMode, SecretSource, Services,
};

// The deployment's configuration values. This function is the operator
// surface: its literals are the defaults a new deployment starts from, and
// revisions edit them in place. Third-party images are versioned inputs to
// that contract; update their mirrors and both definition formats together.
fn config() -> Ecs {
    Ecs {
        environment: "dev".into(),
        aws: Aws {
            region: "eu-west-2".into(),
        },
        cluster: Cluster {
            name: "tokeira".into(),
            service_connect_namespace: "tokeira.internal".into(),
        },
        networking: Networking {
            vpc_cidr: "10.42.0.0/16".into(),
            availability_zones: vec![
                "eu-west-2a".into(),
                "eu-west-2b".into(),
                "eu-west-2c".into(),
            ],
            private_dns_zone: "tokeira.internal".into(),
        },
        dsql: Dsql::Managed,
        images: Images {
            tokeirad: BuildImage {
                name: "tokeirad".into(),
                repository: "tokeirad".into(),
                tag: "latest".into(),
            },
            autoscaler: BuildImage {
                name: "tokeira-autoscaler".into(),
                repository: "tokeira-autoscaler".into(),
                tag: "latest".into(),
            },
            mimir: MirrorImage {
                name: "grafana-mimir".into(),
                repository: "mimir".into(),
                tag: "3.2.0".into(),
                upstream_ref: "grafana/mimir:3.2.0".into(),
            },
            loki: MirrorImage {
                name: "grafana-loki".into(),
                repository: "loki".into(),
                tag: "3.7.6".into(),
                upstream_ref: "grafana/loki:3.7.6".into(),
            },
            grafana: MirrorImage {
                name: "grafana".into(),
                repository: "grafana".into(),
                tag: "12.4.9".into(),
                upstream_ref: "grafana/grafana:12.4.9".into(),
            },
            alloy: MirrorImage {
                name: "grafana-alloy".into(),
                repository: "alloy".into(),
                tag: "v1.19.0".into(),
                upstream_ref: "grafana/alloy:v1.19.0".into(),
            },
            aws_cli: MirrorImage {
                name: "aws-cli".into(),
                repository: "aws-cli".into(),
                tag: "2.17.0".into(),
                upstream_ref: "amazon/aws-cli:2.17.0".into(),
            },
            busybox: MirrorImage {
                name: "busybox".into(),
                repository: "busybox".into(),
                tag: "1.36".into(),
                upstream_ref: "busybox:1.36".into(),
            },
        },
        services: Services {
            edge_api: ReplicaPolicy {
                replicas: 2,
                cpu: 1024,
                memory_mb: 2048,
            },
            edge_poll: ReplicaPolicy {
                replicas: 2,
                cpu: 1024,
                memory_mb: 2048,
            },
            runtime: DaemonPolicy {
                cpu: 2048,
                memory_mb: 4096,
            },
            projection: ReplicaPolicy {
                replicas: 2,
                cpu: 1024,
                memory_mb: 2048,
            },
            controller: ReplicaPolicy {
                replicas: 1,
                cpu: 512,
                memory_mb: 1024,
            },
            autoscaler: ReplicaPolicy {
                replicas: 1,
                cpu: 512,
                memory_mb: 1024,
            },
            admin: ReplicaPolicy {
                replicas: 0,
                cpu: 512,
                memory_mb: 1024,
            },
        },
        capacity: Capacity {
            edge_api: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 2,
                max: 8,
            },
            edge_poll: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 2,
                max: 8,
            },
            runtime: CapacityPlane {
                instance_type: "c8g.xlarge".into(),
                min: 1,
                desired: 2,
                max: 8,
            },
            projection: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 2,
                max: 8,
            },
            control: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 1,
                max: 4,
            },
            mimir: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 1,
                max: 1,
            },
            loki: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 1,
                max: 1,
            },
            grafana: CapacityPlane {
                instance_type: "c8g.large".into(),
                min: 1,
                desired: 1,
                max: 1,
            },
        },
        alb: Alb {
            protocol: AlbProtocol::Http2,
            health_check_path: "/health".into(),
            health_check_interval_secs: 30,
        },
        observability: Observability {
            mimir: ReplicaPolicy {
                replicas: 1,
                cpu: 1024,
                memory_mb: 2048,
            },
            loki: ReplicaPolicy {
                replicas: 1,
                cpu: 1024,
                memory_mb: 2048,
            },
            grafana: ReplicaPolicy {
                replicas: 1,
                cpu: 512,
                memory_mb: 1024,
            },
            loki_query_url: "http://localhost:3100".into(),
        },
    }
}

// The deployment graph. Module dependencies order coarsely; the resources
// declared here are the ones several parts stand on, passed to each part
// that needs them.
fn deployment(cfg: Ecs, cx: Context) -> Deployment {
    let d = Deployment::new(&["default"]);

    // State admission is the ordering root everything else stands on. The
    // shell already opened the selected local/S3 stores; the module must not
    // re-author that deployment-level location as ECS desired state.
    let remote_state = d.module("remote_state", vec![]);
    remote_state::define(d, cfg, cx, remote_state);

    // Image repositories depend on the bootstrap only — the single
    // dependency-free module is the framework's bootstrap contract.
    let images = d.module("images", vec![remote_state]);
    images::define(d, cfg, cx, images);

    // Networking: the VPC and cross-part security groups are
    // declared at the root so downstream parts can depend on them.
    let networking = d.module("networking", vec![remote_state]);
    let vpc = networking.resource(
        "vpc",
        Vpc {
            region: cfg.aws.region.clone(),
            cidr: cfg.networking.vpc_cidr.clone(),
            availability_zones: cfg.networking.availability_zones.clone(),
        },
    );
    let endpoint_sg = networking.resource(
        "sg-vpc-endpoints",
        SecurityGroup {
            region: cfg.aws.region.clone(),
            name: "vpc-endpoints".into(),
            description: "Tokeira ECS VPC endpoints security group".into(),
            ingress: vec![IngressRule {
                description: "private VPC endpoints traffic".into(),
                protocol: "tcp".into(),
                from_port: 443,
                to_port: 443,
                source: cfg.networking.vpc_cidr.clone(),
            }],
        },
        vec![vpc],
    );
    let runtime_sg = networking.resource(
        "sg-runtime",
        SecurityGroup {
            region: cfg.aws.region.clone(),
            name: "runtime".into(),
            description: "Tokeira ECS runtime services security group".into(),
            ingress: vec![IngressRule {
                description: "private VPC runtime services traffic".into(),
                protocol: "tcp".into(),
                from_port: 7241,
                to_port: 7241,
                source: cfg.networking.vpc_cidr.clone(),
            }],
        },
        vec![vpc],
    );
    let edge_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "edge",
        "edge services",
        7233,
    );
    let projection_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "projection",
        "projection services",
        7242,
    );
    let control_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "control",
        "control services",
        7240,
    );
    let mimir_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "mimir",
        "Mimir",
        9009,
    );
    let loki_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "loki",
        "Loki",
        3100,
    );
    let grafana_sg = helpers::edge_group(
        networking,
        vpc,
        cfg.aws.region.clone(),
        cfg.networking.vpc_cidr.clone(),
        "grafana",
        "Grafana",
        3000,
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ecs",
        "ecs",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ecs-agent",
        "ecs-agent",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ecs-telemetry",
        "ecs-telemetry",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ecr-api",
        "ecr.api",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ecr-dkr",
        "ecr.dkr",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "autoscaling",
        "autoscaling",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "servicediscovery",
        "servicediscovery",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ssm",
        "ssm",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ssmmessages",
        "ssmmessages",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "ec2messages",
        "ec2messages",
    );
    helpers::interface(
        networking,
        vpc,
        endpoint_sg,
        cfg.aws.region.clone(),
        "secretsmanager",
        "secretsmanager",
    );
    let edge_api_tg = networking.resource(
        "tg-edge-api",
        AlbTargetGroup {
            name: "tokeira-edge-api".into(),
            port: 7233,
            health_check_path: cfg.alb.health_check_path.clone(),
            health_check_interval_secs: cfg.alb.health_check_interval_secs,
        },
        vec![vpc],
    );
    let edge_poll_tg = networking.resource(
        "tg-edge-poll",
        AlbTargetGroup {
            name: "tokeira-edge-poll".into(),
            port: 7234,
            health_check_path: cfg.alb.health_check_path.clone(),
            health_check_interval_secs: cfg.alb.health_check_interval_secs,
        },
        vec![vpc],
    );
    networking::define(
        d,
        cfg,
        cx,
        networking,
        vpc,
        endpoint_sg,
        edge_api_tg,
        edge_poll_tg,
    );

    let dsql = d.module("dsql", vec![networking]);
    let dsql_cluster = dsql::define(d, cfg, cx, dsql, vpc, endpoint_sg);
    let rate_limiter = dsql.resource(
        "rate_limiter",
        DynamoDbTable {
            table: format!("{}-dsql-rate-limiter", cx.project_name),
            region: cfg.aws.region.clone(),
            hash_key: "pk".into(),
            ttl: Some("ttl_epoch".into()),
        },
    );
    let conn_lease = dsql.resource(
        "conn_lease",
        DynamoDbTable {
            table: format!("{}-dsql-conn-lease", cx.project_name),
            region: cfg.aws.region.clone(),
            hash_key: "pk".into(),
            ttl: Some("ttl_epoch".into()),
        },
    );
    d.writeback("infrastructure.storage", "dsql");
    d.writeback(
        "infrastructure.dsql.endpoint",
        dsql_cluster.output("cluster_endpoint"),
    );
    d.writeback("infrastructure.dsql.region", cfg.aws.region.clone());
    d.writeback(
        "infrastructure.dsql.rate_limiter_table",
        rate_limiter.output("table_name"),
    );
    d.writeback(
        "infrastructure.dsql.conn_lease_table",
        conn_lease.output("table_name"),
    );
    // The DSQL role resources live here, not in the part: their mode
    // carries a tuple-variant payload, and the frontend admits tuple
    // construction in the root document only.
    match &cfg.dsql {
        Dsql::Managed => {
            let runtime_role = dsql.resource(
                "runtime_role",
                DsqlIamRole {
                    id: "dsql:runtime-role".into(),
                    mode: RoleMode::Managed(ManagedRole {
                        region: cfg.aws.region.clone(),
                        role_name: format!("{}-dsql-runtime", cx.project_name),
                        policy_name: "dsql-runtime".into(),
                        action: "dsql:DbConnect".into(),
                    }),
                },
                vec![dsql_cluster],
            );
            let admin_role = dsql.resource(
                "admin_role",
                DsqlIamRole {
                    id: "dsql:admin-role".into(),
                    mode: RoleMode::Managed(ManagedRole {
                        region: cfg.aws.region.clone(),
                        role_name: format!("{}-dsql-admin", cx.project_name),
                        policy_name: "dsql-admin".into(),
                        action: "dsql:DbConnectAdmin".into(),
                    }),
                },
                vec![dsql_cluster],
            );
            d.writeback(
                "infrastructure.dsql.runtime_role_arn",
                runtime_role.output("role_arn"),
            );
            d.writeback(
                "infrastructure.dsql.admin_role_arn",
                admin_role.output("role_arn"),
            );
        }
        Dsql::Preexisting(adopted) => {
            let runtime_role = dsql.resource(
                "runtime_role",
                DsqlIamRole {
                    id: "dsql:runtime-role".into(),
                    mode: RoleMode::Preexisting(PreexistingRole {
                        role_arn: adopted.runtime_role_arn.clone(),
                    }),
                },
            );
            let admin_role = dsql.resource(
                "admin_role",
                DsqlIamRole {
                    id: "dsql:admin-role".into(),
                    mode: RoleMode::Preexisting(PreexistingRole {
                        role_arn: adopted.admin_role_arn.clone(),
                    }),
                },
            );
            d.writeback(
                "infrastructure.dsql.runtime_role_arn",
                runtime_role.output("role_arn"),
            );
            d.writeback(
                "infrastructure.dsql.admin_role_arn",
                admin_role.output("role_arn"),
            );
        }
    }

    // The cluster part declares the cluster itself; its eight capacity
    // planes are the same assembly wired here, one helper call per plane.
    let cluster = d.module("cluster", vec![dsql]);
    let ecs_cluster = cluster::define(d, cfg, cx, cluster);
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-edge-api",
        "edge-api",
        cfg.capacity.edge_api,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-edge-poll",
        "edge-poll",
        cfg.capacity.edge_poll,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-runtime",
        "runtime",
        cfg.capacity.runtime,
        true,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-projection",
        "projection",
        cfg.capacity.projection,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-control",
        "control",
        cfg.capacity.control,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-mimir",
        "mimir",
        cfg.capacity.mimir,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-loki",
        "loki",
        cfg.capacity.loki,
        false,
    );
    helpers::plane(
        cluster,
        cx,
        vpc,
        runtime_sg,
        ecs_cluster,
        cfg.aws.region.clone(),
        cfg.cluster.name.clone(),
        "cp-grafana",
        "grafana",
        cfg.capacity.grafana,
        false,
    );

    let observability = d.module("observability", vec![cluster, images]);
    let mimir_task_role = observability.resource(
        "mimir_task_role",
        EcsTaskRole {
            service: "tokeira-mimir".into(),
            region: cfg.aws.region.clone(),
        },
    );
    let loki_task_role = observability.resource(
        "loki_task_role",
        EcsTaskRole {
            service: "tokeira-loki".into(),
            region: cfg.aws.region.clone(),
        },
    );
    let grafana_task_role = observability.resource(
        "grafana_task_role",
        EcsTaskRole {
            service: "tokeira-grafana".into(),
            region: cfg.aws.region.clone(),
        },
    );
    let grafana_execution_role = observability.resource(
        "grafana_execution_role",
        EcsExecutionRole {
            service: "tokeira-grafana".into(),
            region: cfg.aws.region.clone(),
        },
    );
    observability::define(d, cfg, cx, observability);
    // The Grafana admin secret lives here for the same tuple-variant
    // reason as the DSQL roles.
    observability.resource(
        "grafana_admin_secret",
        SecretsManagerSecret {
            region: cfg.aws.region.clone(),
            name: "tokeira/grafana/admin".into(),
            source: SecretSource::GeneratedPasswordJson(GeneratedPassword {
                username: "admin".into(),
                password_length: 32,
            }),
            recovery_window_days: 7,
        },
    );
    helpers::alloy(observability, cfg, "tokeira-edge-api");
    helpers::alloy(observability, cfg, "tokeira-edge-poll");
    helpers::alloy(observability, cfg, "tokeira-runtime");
    helpers::alloy(observability, cfg, "tokeira-projection");
    helpers::alloy(observability, cfg, "tokeira-controller");
    helpers::alloy(observability, cfg, "tokeira-autoscaler");
    helpers::alloy(observability, cfg, "tokeira-admin");
    helpers::alloy(observability, cfg, "tokeira-mimir");
    helpers::alloy(observability, cfg, "tokeira-loki");
    helpers::alloy(observability, cfg, "tokeira-grafana");

    let services = d.module("services", vec![observability, images]);
    let server_config = services.resource("server_config", ServerConfig {});
    services::define(cfg, services, vpc, control_sg);
    let edge_api_task_role =
        helpers::task_role(services, cfg.aws.region.clone(), "tokeira-edge-api");
    let edge_poll_task_role =
        helpers::task_role(services, cfg.aws.region.clone(), "tokeira-edge-poll");
    let runtime_task_role = helpers::task_role(services, cfg.aws.region.clone(), "tokeira-runtime");
    let projection_task_role =
        helpers::task_role(services, cfg.aws.region.clone(), "tokeira-projection");
    let controller_task_role =
        helpers::task_role(services, cfg.aws.region.clone(), "tokeira-controller");
    let admin_task_role = helpers::task_role(services, cfg.aws.region.clone(), "tokeira-admin");
    helpers::replica(
        services,
        cfg,
        "tokeira-edge-api",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.edge_api,
        vec![edge_api_task_role, vpc, edge_sg, edge_api_tg, server_config],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-edge-poll",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.edge_poll,
        vec![
            edge_poll_task_role,
            vpc,
            edge_sg,
            edge_poll_tg,
            server_config,
        ],
    );
    helpers::daemon(
        services,
        cfg,
        "tokeira-runtime",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.runtime,
        vec![runtime_task_role, vpc, runtime_sg, server_config],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-projection",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.projection,
        vec![projection_task_role, vpc, projection_sg, server_config],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-controller",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.controller,
        vec![controller_task_role, vpc, control_sg],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-admin",
        format!("{}:{}", cfg.images.tokeirad.repository, cfg.images.tokeirad.tag),
        cfg.services.admin,
        vec![admin_task_role, vpc, control_sg, server_config],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-mimir",
        format!("{}:{}", cfg.images.mimir.repository, cfg.images.mimir.tag),
        cfg.observability.mimir,
        vec![mimir_task_role, vpc, mimir_sg],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-loki",
        format!("{}:{}", cfg.images.loki.repository, cfg.images.loki.tag),
        cfg.observability.loki,
        vec![loki_task_role, vpc, loki_sg],
    );
    helpers::replica(
        services,
        cfg,
        "tokeira-grafana",
        format!("{}:{}", cfg.images.grafana.repository, cfg.images.grafana.tag),
        cfg.observability.grafana,
        vec![grafana_task_role, grafana_execution_role, vpc, grafana_sg],
    );

    d
}
