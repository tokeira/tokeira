// The dsql module: workflow storage in both provenances, always realizing
// the same five well-known identities — cluster, management endpoint,
// connection endpoint, runtime role, admin role — so every consumer and
// writeback binds the same names in either mode.
//
// Writebacks: managed mode declares three of the five DSQL writebacks. The
// two endpoint-id writebacks require `endpoint_id` in the realized
// endpoints' declared outputs, and those resources (VpcEndpoint,
// DsqlConnectionEndpoint in tokeira-aws/src/resources) do not declare
// outputs yet — a two-line follow-up outside this change's writable scope.
// Preexisting mode's sources are the platform's own adopters, which declare
// their outputs, so it writes all five back.

use platform::{Dsql, Ecs};

pub fn define(d: Deployment, cfg: Ecs, cx: Context, dsql: Module, vpc: Resource, endpoint_sg: Resource) {
    match &cfg.dsql {
        Dsql::Managed => {
            let cluster = dsql.resource(
                "cluster",
                DsqlCluster {
                    identity: format!("{}-{}", cx.project_name, cfg.environment),
                    region: cfg.aws.region.clone(),
                    mode: DsqlClusterMode::Managed,
                    id: "dsql:cluster".into(),
                },
            );
            dsql.resource(
                "management_endpoint",
                VpcEndpoint {
                    region: cfg.aws.region.clone(),
                    short_name: "dsql-management".into(),
                    service_name: format!("com.amazonaws.{}.dsql-control", cfg.aws.region),
                    endpoint_type: EndpointKind::Interface,
                    id: "dsql:management-endpoint".into(),
                },
                vec![vpc, endpoint_sg],
            );
            dsql.resource(
                "connection_endpoint",
                DsqlConnectionEndpoint {
                    region: cfg.aws.region.clone(),
                    identity: format!("{}-connection", cx.project_name),
                    id: "dsql:connection-endpoint".into(),
                },
                vec![vpc, endpoint_sg, cluster],
            );
            let runtime_role = dsql.resource(
                "runtime_role",
                DsqlIamRole {
                    id: "dsql:runtime-role".into(),
                    mode: RoleMode::Managed(ManagedRole {
                        region: cfg.aws.region.clone(),
                        role_name: format!("{}-dsql-runtime", cx.project_name),
                        policy_name: "dsql-runtime".into(),
                        action: "dsql:DbConnect".into(),
                    }),
                },
                vec![cluster],
            );
            let admin_role = dsql.resource(
                "admin_role",
                DsqlIamRole {
                    id: "dsql:admin-role".into(),
                    mode: RoleMode::Managed(ManagedRole {
                        region: cfg.aws.region.clone(),
                        role_name: format!("{}-dsql-admin", cx.project_name),
                        policy_name: "dsql-admin".into(),
                        action: "dsql:DbConnectAdmin".into(),
                    }),
                },
                vec![cluster],
            );

            d.writeback("dsql.endpoint", cluster.output("cluster_endpoint"));
            d.writeback("dsql.runtime_role_arn", runtime_role.output("role_arn"));
            d.writeback("dsql.admin_role_arn", admin_role.output("role_arn"));
        }
        Dsql::Preexisting(adopted) => {
            let cluster = dsql.resource(
                "cluster",
                DsqlCluster {
                    identity: format!("{}-{}", cx.project_name, cfg.environment),
                    region: cfg.aws.region.clone(),
                    mode: DsqlClusterMode::Preexisting,
                    endpoint: adopted.endpoint.clone(),
                    id: "dsql:cluster".into(),
                },
            );
            let management = dsql.resource(
                "management_endpoint",
                DsqlEndpoint {
                    id: "dsql:management-endpoint".into(),
                    endpoint_id: adopted.management_endpoint_id.clone(),
                },
            );
            let connection = dsql.resource(
                "connection_endpoint",
                DsqlEndpoint {
                    id: "dsql:connection-endpoint".into(),
                    endpoint_id: adopted.connection_endpoint_id.clone(),
                },
            );
            let runtime_role = dsql.resource(
                "runtime_role",
                DsqlIamRole {
                    id: "dsql:runtime-role".into(),
                    mode: RoleMode::Preexisting(PreexistingRole {
                        role_arn: adopted.runtime_role_arn.clone(),
                    }),
                },
            );
            let admin_role = dsql.resource(
                "admin_role",
                DsqlIamRole {
                    id: "dsql:admin-role".into(),
                    mode: RoleMode::Preexisting(PreexistingRole {
                        role_arn: adopted.admin_role_arn.clone(),
                    }),
                },
            );

            d.writeback("dsql.endpoint", cluster.output("cluster_endpoint"));
            d.writeback("dsql.management_endpoint_id", management.output("endpoint_id"));
            d.writeback("dsql.connection_endpoint_id", connection.output("endpoint_id"));
            d.writeback("dsql.runtime_role_arn", runtime_role.output("role_arn"));
            d.writeback("dsql.admin_role_arn", admin_role.output("role_arn"));
        }
    }
}
