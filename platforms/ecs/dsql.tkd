// The dsql module: workflow storage in both provenances, always realizing
// the same five well-known identities — cluster, management endpoint,
// connection endpoint, runtime role, and admin role — so every consumer
// binds the same names in either mode. Canonical server-config writebacks
// live in the root beside the shared DynamoDB coordination tables.
//
// The role resources and their writebacks live in the root: their mode
// carries a tuple-variant payload, and the TKD frontend admits tuple-variant
// construction in the root document only. This part declares the cluster
// and endpoint identities.
//
// Managed resources publish provider-assigned endpoint IDs; preexisting
// adopters publish the authored IDs under the same infrastructure identities.

use platform::{Dsql, DsqlClusterMode, Ecs, EndpointKind};

pub fn define(
    d: Deployment,
    cfg: Ecs,
    cx: Context,
    dsql: Module,
    vpc: Resource,
    endpoint_sg: Resource,
) -> Resource {
    match &cfg.dsql {
        Dsql::Managed => {
            let cluster = dsql.resource(
                "cluster",
                DsqlCluster {
                    identity: format!("{}-{}", cx.project_name, cfg.environment),
                    region: cfg.aws.region.clone(),
                    mode: DsqlClusterMode::Managed,
                    id: "dsql:cluster".into(),
                },
            );
            let management = dsql.resource(
                "management_endpoint",
                VpcEndpoint {
                    region: cfg.aws.region.clone(),
                    short_name: "dsql-management".into(),
                    service_name: format!("com.amazonaws.{}.dsql-control", cfg.aws.region),
                    endpoint_type: EndpointKind::Interface,
                    id: "dsql:management-endpoint".into(),
                },
                vec![vpc, endpoint_sg],
            );
            let connection = dsql.resource(
                "connection_endpoint",
                DsqlConnectionEndpoint {
                    region: cfg.aws.region.clone(),
                    identity: format!("{}-connection", cx.project_name),
                    id: "dsql:connection-endpoint".into(),
                },
                vec![vpc, endpoint_sg, cluster],
            );
            cluster
        }
        Dsql::Preexisting(adopted) => {
            let cluster = dsql.resource(
                "cluster",
                DsqlCluster {
                    identity: format!("{}-{}", cx.project_name, cfg.environment),
                    region: cfg.aws.region.clone(),
                    mode: DsqlClusterMode::Preexisting,
                    endpoint: adopted.endpoint.clone(),
                    arn: adopted.arn.clone(),
                    id: "dsql:cluster".into(),
                },
            );
            let management = dsql.resource(
                "management_endpoint",
                DsqlEndpoint {
                    id: "dsql:management-endpoint".into(),
                    endpoint_id: adopted.management_endpoint_id.clone(),
                },
            );
            let connection = dsql.resource(
                "connection_endpoint",
                DsqlEndpoint {
                    id: "dsql:connection-endpoint".into(),
                    endpoint_id: adopted.connection_endpoint_id.clone(),
                },
            );
            cluster
        }
    }
}
