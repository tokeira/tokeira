// Shared declaration helpers: the repeated assemblies the module parts
// call, one per shape. Parts may only call across part boundaries, so the
// helpers live here as a part of their own.

use platform::{CapacityPlane, DaemonPolicy, Ecs, EndpointKind, IngressRule, ReplicaPolicy};

// A workload-family security group on its canonical port. Tasks communicate
// across family groups, so the private VPC CIDR — not `self` — is the ingress
// source. The resource is returned for the workload's explicit dependency.
pub fn edge_group(networking: Module, vpc: Resource, region: String, vpc_cidr: String, name: String, description: String, port: u16) -> Resource {
    networking.resource(
        format!("sg-{}", name),
        SecurityGroup {
            region: region,
            name: name.clone(),
            description: format!("Tokeira ECS {} security group", description),
            ingress: vec![IngressRule {
                description: format!("private VPC {} traffic", description),
                protocol: "tcp".into(),
                from_port: port,
                to_port: port,
                source: vpc_cidr,
            }],
        },
        vec![vpc],
    )
}

// One interface endpoint for a private AWS service.
pub fn interface(networking: Module, vpc: Resource, endpoint_sg: Resource, region: String, short: String, service: String) {
    networking.resource(
        format!("vpce-{}", short),
        VpcEndpoint {
            region: region.clone(),
            short_name: short,
            service_name: format!("com.amazonaws.{}.{}", region, service),
            endpoint_type: EndpointKind::Interface,
        },
        vec![vpc, endpoint_sg],
    );
}

// One capacity plane: role, profile, launch template, auto-scaling group,
// capacity provider. `protect` guards fresh instances from scale-in — the
// runtime plane's managed-draining policy.
pub fn plane(cluster: Module, cx: Context, vpc: Resource, runtime_sg: Resource, ecs_cluster: Resource, region: String, cluster_name: String, name: String, workload: String, policy: CapacityPlane, protect: bool) {
    let profile_name = format!("{}-{}-instance", cx.project_name, name);
    let role_name = format!("{}-role", profile_name);
    let role = cluster.resource(
        format!("role-{}", name),
        IamRole {
            region: region.clone(),
            name: role_name.clone(),
            trust_policy: "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ec2.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}".into(),
            managed_policy_arns: vec![
                "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role".into(),
                "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore".into(),
            ],
        },
    );
    let profile = cluster.resource(
        format!("profile-{}", name),
        IamInstanceProfile {
            region: region.clone(),
            profile_name: profile_name.clone(),
            role_name: role_name,
        },
        vec![role],
    );
    let launch_template = cluster.resource(
        format!("lt-{}", name),
        LaunchTemplate {
            name: name.clone(),
            cluster_name: cluster_name,
            instance_type: policy.instance_type.clone(),
            workload: workload,
            instance_profile_name: profile_name,
        },
        vec![runtime_sg, profile],
    );
    let asg = cluster.resource(
        format!("asg-{}", name),
        AutoScalingGroup {
            name: name.clone(),
            min_size: policy.min,
            desired_capacity: policy.desired,
            max_size: policy.max,
            new_instances_protected_from_scale_in: protect,
        },
        vec![launch_template, vpc],
    );
    cluster.resource(
        format!("cp-{}", name),
        EcsCapacityProvider { name: name },
        vec![ecs_cluster, asg],
    );
}

// One rendered Alloy sidecar configuration parameter.
pub fn alloy(observability: Module, region: String, service: String) {
    observability.resource(
        format!("alloy-{}", service),
        AlloyConfig { service: service, region: region },
    );
}

// One application task role, returned so the workload can name it as an
// infrastructure dependency.
pub fn task_role(services: Module, region: String, service: String) -> Resource {
    services.resource(
        format!("task-role-{}", service),
        EcsTaskRole { service: service, region: region },
    )
}

// One replica-scheduled workload.
pub fn replica(services: Module, cfg: Ecs, service: String, policy: ReplicaPolicy, roles: Vec<Resource>) {
    services.resource(
        service.clone(),
        EcsWorkload {
            service: service,
            environment: cfg.environment.clone(),
            region: cfg.aws.region.clone(),
            cluster: cfg.cluster.name.clone(),
            service_connect_namespace: cfg.cluster.service_connect_namespace.clone(),
            image: policy.image.clone(),
            replicas: policy.replicas,
            cpu: policy.cpu,
            memory_mb: policy.memory_mb,
            alloy_image: cfg.observability.alloy_image.clone(),
            aws_cli_image: cfg.observability.aws_cli_image.clone(),
            busybox_image: cfg.observability.busybox_image.clone(),
        },
        roles,
    );
}

// One daemon-scheduled workload: no replica count to author.
pub fn daemon(services: Module, cfg: Ecs, service: String, policy: DaemonPolicy, roles: Vec<Resource>) {
    services.resource(
        service.clone(),
        EcsWorkload {
            service: service,
            environment: cfg.environment.clone(),
            region: cfg.aws.region.clone(),
            cluster: cfg.cluster.name.clone(),
            service_connect_namespace: cfg.cluster.service_connect_namespace.clone(),
            image: policy.image.clone(),
            cpu: policy.cpu,
            memory_mb: policy.memory_mb,
            alloy_image: cfg.observability.alloy_image.clone(),
            aws_cli_image: cfg.observability.aws_cli_image.clone(),
            busybox_image: cfg.observability.busybox_image.clone(),
        },
        roles,
    );
}
