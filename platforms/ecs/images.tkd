// The images module: one ECR repository per image the deployment builds or
// mirrors. The definition's image inventory owns every suffix; this module
// adds only the deployment-name prefix that keeps ECR repositories isolated.

use platform::Ecs;

pub fn define(d: Deployment, cfg: Ecs, cx: Context, images: Module) {
    images.resource(
        "tokeirad",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.tokeirad.repository),
        },
    );
    images.resource(
        "tokeira-autoscaler",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.autoscaler.repository),
        },
    );
    images.resource(
        "mimir",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.mimir.repository),
        },
    );
    images.resource(
        "loki",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.loki.repository),
        },
    );
    images.resource(
        "grafana",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.grafana.repository),
        },
    );
    images.resource(
        "alloy",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.alloy.repository),
        },
    );
    images.resource(
        "aws-cli",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.aws_cli.repository),
        },
    );
    images.resource(
        "busybox",
        EcrRepository {
            repository: format!("{}/{}", cx.project_name, cfg.images.busybox.repository),
        },
    );
}
