// The networking module: the private VPC, the six workload-family security
// groups, the AWS service endpoints private tasks reach, and the internal
// ALB stack routing the two edge services.
//
// Ports here are the platform's canonical service ports — derived facts of
// the topology, not operator policy, so they are literals in this document.

use platform::{AlbProtocol, Ecs};

pub fn define(d: Deployment, cfg: Ecs, cx: Context, networking: Module) {
    let vpc = networking.resource(
        "vpc",
        Vpc {
            region: cfg.aws.region.clone(),
            cidr: cfg.networking.vpc_cidr.clone(),
            availability_zones: cfg.networking.availability_zones.clone(),
        },
    );

    // The ALB group listens on the listener's own port; the others carry
    // their family's canonical gRPC port; the endpoint group carries TLS.
    let listener_port = match &cfg.alb.protocol {
        AlbProtocol::Http2 => 80,
        AlbProtocol::Https(_) => 443,
    };

    let alb_sg = networking.resource(
        "sg-alb",
        SecurityGroup {
            region: cfg.aws.region.clone(),
            name: "alb".into(),
            description: "Tokeira ECS internal ALB security group".into(),
            ingress: vec![IngressRule {
                description: "self internal ALB traffic".into(),
                protocol: "tcp".into(),
                from_port: listener_port,
                to_port: listener_port,
                source: "self".into(),
            }],
        },
        vec![vpc],
    );

    edge_group(networking, vpc, cfg.aws.region.clone(), "edge", "edge services", 7233);
    edge_group(networking, vpc, cfg.aws.region.clone(), "runtime", "runtime services", 7241);
    edge_group(networking, vpc, cfg.aws.region.clone(), "projection", "projection services", 7242);
    edge_group(networking, vpc, cfg.aws.region.clone(), "control", "control services", 7240);
    let endpoint_sg = networking.resource(
        "sg-vpc-endpoints",
        SecurityGroup {
            region: cfg.aws.region.clone(),
            name: "vpc-endpoints".into(),
            description: "Tokeira ECS VPC endpoints security group".into(),
            ingress: vec![IngressRule {
                description: "self VPC endpoints traffic".into(),
                protocol: "tcp".into(),
                from_port: 443,
                to_port: 443,
                source: "self".into(),
            }],
        },
        vec![vpc],
    );

    // The private substrate's required AWS endpoints. Interface endpoints
    // attach the endpoint security group; the S3 gateway rides the route
    // tables. DSQL's own endpoints belong to the dsql module.
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ecs", "ecs");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ecs-agent", "ecs-agent");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ecs-telemetry", "ecs-telemetry");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ecr-api", "ecr.api");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ecr-dkr", "ecr.dkr");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "autoscaling", "autoscaling");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "servicediscovery", "servicediscovery");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ssm", "ssm");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ssmmessages", "ssmmessages");
    interface(networking, vpc, endpoint_sg, cfg.aws.region.clone(), "ec2messages", "ec2messages");
    networking.resource(
        "vpce-s3",
        VpcEndpoint {
            region: cfg.aws.region.clone(),
            short_name: "s3".into(),
            service_name: format!("com.amazonaws.{}.s3", cfg.aws.region),
            endpoint_type: EndpointKind::Gateway,
        },
        vec![vpc],
    );

    // The internal ALB and its two edge routes.
    let alb = networking.resource(
        "alb",
        Alb { name: "tokeira".into() },
        vec![vpc, alb_sg],
    );
    let edge_api_tg = networking.resource(
        "tg-edge-api",
        AlbTargetGroup {
            name: "tokeira-edge-api".into(),
            port: 7233,
            health_check_path: cfg.alb.health_check_path.clone(),
            health_check_interval_secs: cfg.alb.health_check_interval_secs,
        },
        vec![vpc],
    );
    let edge_poll_tg = networking.resource(
        "tg-edge-poll",
        AlbTargetGroup {
            name: "tokeira-edge-poll".into(),
            port: 7234,
            health_check_path: cfg.alb.health_check_path.clone(),
            health_check_interval_secs: cfg.alb.health_check_interval_secs,
        },
        vec![vpc],
    );
    networking.resource(
        "listener",
        AlbListener {
            name: "tokeira".into(),
            protocol: match &cfg.alb.protocol {
                AlbProtocol::Http2 => ListenerProtocol::Http2,
                AlbProtocol::Https(_) => ListenerProtocol::Https,
            },
            certificate_arn: match &cfg.alb.protocol {
                AlbProtocol::Https(arn) => Some(arn.clone()),
                AlbProtocol::Http2 => None,
            },
            private_dns_zone: cfg.networking.private_dns_zone.clone(),
            edge_api_target_group: "tokeira-edge-api".into(),
            edge_poll_target_group: "tokeira-edge-poll".into(),
        },
        vec![alb, edge_api_tg, edge_poll_tg],
    );
}

// A workload-family security group on its canonical port.
pub fn edge_group(networking: Module, vpc: Resource, region: String, name: String, description: String, port: u16) {
    networking.resource(
        format!("sg-{}", name),
        SecurityGroup {
            region: region,
            name: name.clone(),
            description: format!("Tokeira ECS {} security group", description),
            ingress: vec![IngressRule {
                description: format!("self {} traffic", description),
                protocol: "tcp".into(),
                from_port: port,
                to_port: port,
                source: "self".into(),
            }],
        },
        vec![vpc],
    );
}

// One interface endpoint for a private AWS service.
pub fn interface(networking: Module, vpc: Resource, endpoint_sg: Resource, region: String, short: String, service: String) {
    networking.resource(
        format!("vpce-{}", short),
        VpcEndpoint {
            region: region.clone(),
            short_name: short,
            service_name: format!("com.amazonaws.{}.{}", region, service),
            endpoint_type: EndpointKind::Interface,
        },
        vec![vpc, endpoint_sg],
    );
}
