// The networking module: the private VPC, the workload-family security
// groups, the AWS service endpoints private tasks reach, and the internal
// ALB stack routing the two edge services.
//
// Ports here are the platform's canonical service ports — derived facts of
// the topology, not operator policy, so they are literals in this document.

use platform::{AlbProtocol, Ecs, EndpointKind, IngressRule, ListenerProtocol};

// The VPC and the endpoint security group arrive from the root, which owns
// the resources several parts stand on. This part declares the rest.
pub fn define(
    d: Deployment,
    cfg: Ecs,
    cx: Context,
    networking: Module,
    vpc: Resource,
    endpoint_sg: Resource,
    edge_api_tg: Resource,
    edge_poll_tg: Resource,
) {
    // The ALB group listens on the listener's own port; the others carry
    // their family's canonical gRPC port.
    let listener_port = match &cfg.alb.protocol {
        AlbProtocol::Http2 => 80,
        AlbProtocol::Https(_) => 443,
    };

    let alb_sg = networking.resource(
        "sg-alb",
        SecurityGroup {
            region: cfg.aws.region.clone(),
            name: "alb".into(),
            description: "Tokeira ECS internal ALB security group".into(),
            ingress: vec![IngressRule {
                description: "private VPC internal ALB traffic".into(),
                protocol: "tcp".into(),
                from_port: listener_port,
                to_port: listener_port,
                source: cfg.networking.vpc_cidr.clone(),
            }],
        },
        vec![vpc],
    );

    // The private substrate's required AWS endpoints. Interface endpoints
    // attach the endpoint security group; the S3 gateway rides the route
    // tables. DSQL's own endpoints belong to the dsql module.
    networking.resource(
        "vpce-s3",
        VpcEndpoint {
            region: cfg.aws.region.clone(),
            short_name: "s3".into(),
            service_name: format!("com.amazonaws.{}.s3", cfg.aws.region),
            endpoint_type: EndpointKind::Gateway,
        },
        vec![vpc],
    );

    // The internal ALB and its two edge routes.
    let alb = networking.resource(
        "alb",
        Alb {
            name: "tokeira".into(),
        },
        vec![vpc, alb_sg],
    );
    networking.resource(
        "listener",
        AlbListener {
            name: "tokeira".into(),
            protocol: match &cfg.alb.protocol {
                AlbProtocol::Http2 => ListenerProtocol::Http2,
                AlbProtocol::Https(_) => ListenerProtocol::Https,
            },
            certificate_arn: match &cfg.alb.protocol {
                AlbProtocol::Https(tls) => Some(tls.certificate_arn.clone()),
                AlbProtocol::Http2 => None,
            },
            private_dns_zone: cfg.networking.private_dns_zone.clone(),
            edge_api_target_group: "tokeira-edge-api".into(),
            edge_poll_target_group: "tokeira-edge-poll".into(),
        },
        vec![alb, edge_api_tg, edge_poll_tg],
    );
}
