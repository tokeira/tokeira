{
  "uid": "tokeira-autoscaler",
  "title": "Autoscaler",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["tokeira", "autoscaler"],
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Mimir",
          "value": "mimir"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Decisions",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scaling Decisions/s",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum by (loop, direction) (rate(tokeira_autoscaler_scaling_decisions_total[5m]))",
          "legendFormat": "{{loop}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "pointSize": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "mean", "max"]
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "description": "Autoscaler decisions grouped by bounded loop and direction labels."
    }
  ]
}
