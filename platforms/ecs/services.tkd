// The services module: the application workloads' task and execution roles
// (infrastructure), and every workload
// as a deploy-plane service. Infrastructure apply never deploys a workload:
// the Workload resources here carry manifests the deploy engine applies in
// its own `deploy plan`/`deploy apply` pass.
//
// The cluster owns its Service Connect default namespace. ECS creates that
// namespace as part of the cluster contract, so declaring a second Cloud Map
// namespace here would create two resources for the same authored name.

use platform::{DaemonPolicy, Ecs, ReplicaPolicy};

pub fn define(cfg: Ecs, services: Module, vpc: Resource, control_sg: Resource) {
    let task_role = services.resource(
        "task-role-tokeira-autoscaler",
        EcsTaskRole {
            service: "tokeira-autoscaler".into(),
            region: cfg.aws.region.clone(),
        },
    );
    services.resource(
        "tokeira-autoscaler",
        EcsWorkload {
            service: "tokeira-autoscaler".into(),
            environment: cfg.environment.clone(),
            region: cfg.aws.region.clone(),
            cluster: cfg.cluster.name.clone(),
            image: cfg.services.autoscaler.image.clone(),
            replicas: cfg.services.autoscaler.replicas,
            cpu: cfg.services.autoscaler.cpu,
            memory_mb: cfg.services.autoscaler.memory_mb,
            alloy_image: cfg.observability.alloy_image.clone(),
            aws_cli_image: cfg.observability.aws_cli_image.clone(),
            busybox_image: cfg.observability.busybox_image.clone(),
        },
        vec![task_role, vpc, control_sg],
    );
}
