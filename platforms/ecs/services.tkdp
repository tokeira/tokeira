# The services module owns the autoscaler workload. The root declares the
# remaining workloads so it can wire their cross-module role, network,
# target-group, and ServerConfig dependencies. The cluster owns the Service
# Connect default namespace; duplicating it here would create two resources
# for the same authored name.

from tokeira import EcsTaskRole, EcsWorkload


def define(cfg, services, vpc, control_sg):
    task_role = services.resource(
        "task-role-tokeira-autoscaler",
        EcsTaskRole(service="tokeira-autoscaler", region=cfg.aws.region),
    )
    services.resource(
        "tokeira-autoscaler",
        EcsWorkload(
            service="tokeira-autoscaler",
            environment=cfg.environment,
            region=cfg.aws.region,
            cluster=cfg.cluster.name,
            image=cfg.images.autoscaler.repository + ":" + cfg.images.autoscaler.tag,
            replicas=cfg.services.autoscaler.replicas,
            cpu=cfg.services.autoscaler.cpu,
            memory_mb=cfg.services.autoscaler.memory_mb,
            alloy_image=cfg.images.alloy.repository + ":" + cfg.images.alloy.tag,
            aws_cli_image=cfg.images.aws_cli.repository + ":" + cfg.images.aws_cli.tag,
            busybox_image=cfg.images.busybox.repository + ":" + cfg.images.busybox.tag,
        ),
        [task_role, vpc, control_sg],
    )
