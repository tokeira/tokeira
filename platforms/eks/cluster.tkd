// EKS Auto Mode control plane. The exact role names are the dependency
// identities the shared AWS EKS resource reconstructs; namespace and
// NodePool wait on the cluster handle returned here.

use platform::Eks;

pub fn define(
    d: Deployment,
    cfg: Eks,
    cx: Context,
    module: Module,
    vpc: Resource,
    node_sg: Resource,
) -> Resource {
    let cluster_role = module.resource(
        "cluster-role",
        IamRole {
            region: cfg.aws.region.clone(),
            name: format!("{}-eks-cluster-role", cx.project_name),
            trust_policy: "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"eks.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}".into(),
            managed_policy_arns: vec![
                "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy".into(),
                "arn:aws:iam::aws:policy/AmazonEKSComputePolicy".into(),
                "arn:aws:iam::aws:policy/AmazonEKSBlockStoragePolicy".into(),
                "arn:aws:iam::aws:policy/AmazonEKSLoadBalancingPolicy".into(),
                "arn:aws:iam::aws:policy/AmazonEKSNetworkingPolicy".into(),
            ],
        },
    );
    let node_role = module.resource(
        "node-role",
        IamRole {
            region: cfg.aws.region.clone(),
            name: format!("{}-eks-auto-node-role", cx.project_name),
            trust_policy: "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ec2.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}".into(),
            managed_policy_arns: vec![
                "arn:aws:iam::aws:policy/AmazonEKSWorkerNodeMinimalPolicy".into(),
                "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly".into(),
            ],
        },
    );
    let cluster = module.resource(
        "cluster",
        EksCluster {
            region: cfg.aws.region.clone(),
            version: cfg.eks.version,
            namespace: cfg.eks.namespace.clone(),
            kms_key_arn: cfg.eks.kms_key_arn,
            deletion_protection: cfg.eks.deletion_protection,
            bootstrap_admin_permissions: cfg.eks.bootstrap_admin_permissions,
            cluster_admin_principal_arn: cfg.eks.cluster_admin_principal_arn,
        },
        vec![vpc, node_sg, cluster_role, node_role],
    );
    let namespace = module.resource(
        "namespace",
        Namespace {
            name: cfg.eks.namespace,
        },
        vec![cluster],
    );
    module.resource(
        "node-pool",
        NodePool {
            node_families: cfg.eks.node_families,
        },
        vec![cluster],
    );
    cluster
}
