from dataclasses import dataclass


@dataclass
class Tokeirad:
    image: str
    replicas: int
    grpc_port: int
    metrics_port: int


@dataclass
class Observability:
    mimir_image: str
    loki_image: str
    grafana_image: str
    alloy_image: str


@dataclass
class Compose:
    storage: Storage
    tokeirad: Tokeirad
    observability: Observability


def config() -> Compose:
    return Compose(
        storage=InMemory(),
        tokeirad=Tokeirad(
            image="tokeirad:latest",
            replicas=1,
            grpc_port=7233,
            metrics_port=9090,
        ),
        observability=Observability(
            mimir_image="grafana/mimir:3.0.6",
            loki_image="grafana/loki:3.7.1",
            grafana_image="grafana/grafana-oss:12.4.3",
            alloy_image="grafana/alloy:v1.16.0",
        ),
    )


def deployment(cfg: Compose, cx: Context) -> Deployment:
    d = Deployment(["default"])

    match cfg.storage:
        case InMemory():
            state = d.module("local_state")
            state.resource("dir", LocalStateDir())
        case ManagedDsql(region=region):
            dsql = d.module("dsql")
            dsql.resource(
                "cluster",
                DsqlCluster(region=region, mode=Managed),
            )
        case PreexistingDsql(region=region, endpoint=endpoint, arn=_):
            dsql = d.module("dsql")
            dsql.resource(
                "cluster",
                AdoptedDsqlCluster(region=region, endpoint=endpoint),
            )

    server = d.module("tokeirad")
    server.resource("service", cfg.tokeirad)

    obs = d.module("observability")
    obs.resource("stack", cfg.observability)

    return d
