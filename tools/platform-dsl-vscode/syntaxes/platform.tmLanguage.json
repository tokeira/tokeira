{
  "name": "Tokeira Platform DSL",
  "scopeName": "source.platform",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#context" },
    { "include": "#types" },
    { "include": "#field-keys" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.platform",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.platform",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.platform",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.platform",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "platform <name> — the single platform header",
          "match": "\\b(platform)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.platform.platform" },
            "2": { "name": "entity.name.type.namespace.platform" }
          }
        },
        {
          "comment": "module <name> — a resource/service grouping",
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.module.platform" },
            "2": { "name": "entity.name.section.platform" }
          }
        },
        {
          "comment": "input/let <name> — value bindings",
          "match": "\\b(input|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.platform" },
            "2": { "name": "variable.other.declaration.platform" }
          }
        },
        {
          "comment": "service/resource/image <name> — kind instantiations",
          "match": "\\b(service|resource|image)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.platform" },
            "2": { "name": "entity.name.function.platform" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.platform",
          "match": "\\b(when|match|is)\\b"
        },
        {
          "name": "keyword.other.platform",
          "match": "\\b(use|namespaces|writeback|depends_on)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.platform",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "ro/rw — bind mount modes",
          "name": "constant.language.mount-mode.platform",
          "match": "\\b(ro|rw)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Fixed builtin functions; matched only in call position.",
          "name": "support.function.builtin.platform",
          "match": "\\b(port|bind|present_only|value_from|secret_read|generated_password)\\b(?=\\s*\\()"
        }
      ]
    },
    "context": {
      "patterns": [
        {
          "comment": "ctx — the closed runtime-context root (ctx.deployment_dir, ...)",
          "name": "variable.language.ctx.platform",
          "match": "\\bctx\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "UpperCamelCase names are types, resource/service/image kinds, and sum-type variant constructors (String, Port, Storage, ComposeService, DsqlCluster, InMemory, Dsql, Managed, ...).",
          "name": "entity.name.type.platform",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "field-keys": {
      "patterns": [
        {
          "comment": "key: value — field assignments and keyword arguments.",
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.platform" },
            "2": { "name": "punctuation.separator.key-value.platform" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "++ (list concat), => (match arm), .. (record spread), . (field access), / (path join), = (binding).",
          "name": "keyword.operator.platform",
          "match": "(\\+\\+|=>|\\.\\.|\\.|/|=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.platform",
          "match": ","
        },
        {
          "name": "punctuation.section.braces.platform",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.platform",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.platform",
          "match": "[()]"
        }
      ]
    }
  }
}
